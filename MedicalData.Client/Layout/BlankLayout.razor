@inherits LayoutComponentBase

<ErrorBoundary>
    <ChildContent>@Body</ChildContent>
    <ErrorContent Context="ex">
        <div style="padding:24px;background:#fef2f2;border:1px solid #fca5a5;border-radius:10px;margin:20px;font-family:monospace;">
            <strong style="color:#991b1b;">Rendering error:</strong>
            <pre style="color:#7f1d1d;white-space:pre-wrap;margin-top:8px;">@ex.Message&#10;@ex.StackTrace</pre>
        </div>
    </ErrorContent>
</ErrorBoundary>
