@inherits LayoutComponentBase
@inject AuthService Auth
@inject AuthStateProvider AuthState
@inject NavigationManager Nav

<div class="app-shell">
    <header class="app-header">
        <span class="app-brand">🩺 Мої аналізи</span>
        <span style="flex:1;" />
        <AuthorizeView>
            <Authorized>
                @if (userName != null)
                {
                    <div class="user-chip">
                        @if (userPic != null)
                        {
                            <img src="@userPic" class="user-avatar" alt="" />
                        }
                        <span class="user-name">@userName</span>
                        <button class="logout-btn" @onclick="LogoutAsync">Вийти</button>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </header>
    <main class="app-body">
        <ErrorBoundary>
            <ChildContent>@Body</ChildContent>
            <ErrorContent Context="ex">
                <div style="background:#fef2f2;border:1px solid #fca5a5;border-radius:8px;padding:16px;color:#991b1b;">
                    ⚠ @ex.Message
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private string? userName;
    private string? userPic;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var user = await Auth.GetUserAsync();
            if (user.Identity?.IsAuthenticated == true)
            {
                userName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
                userPic  = user.FindFirst("picture")?.Value;
                StateHasChanged();
            }
        }
        catch { /* JS interop not yet ready — silently skip */ }
    }

    private async Task LogoutAsync()
    {
        await Auth.ClearTokenAsync();
        AuthState.NotifyChanged();
        Nav.NavigateTo("/login");
    }
}
