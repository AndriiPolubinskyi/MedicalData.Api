@page "/login"
@layout BlankLayout
@inject IConfiguration Config
@inject NavigationManager Nav
@inject LocalizationService Loc
@implements IDisposable

<div class="login-wrap">
    <div class="login-card">
        <div class="login-logo">🩺</div>
        <h1 class="login-title">@Loc["brand"]</h1>
        <p class="login-sub">@Loc["login.subtitle"]</p>

        <a class="google-btn" href="@LoginUrl">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                 width="20" height="20" alt="Google" />
            @Loc["login.google"]
        </a>

        <div class="lang-switcher" style="margin-top:20px;justify-content:center;">
            <button class="lang-btn @(Loc.Lang == "uk" ? "active" : "")" @onclick='() => SwitchLangAsync("uk")'>UA</button>
            <button class="lang-btn @(Loc.Lang == "en" ? "active" : "")" @onclick='() => SwitchLangAsync("en")'>EN</button>
            <button class="lang-btn @(Loc.Lang == "ru" ? "active" : "")" @onclick='() => SwitchLangAsync("ru")'>RU</button>
        </div>
    </div>
</div>

@code {
    private string LoginUrl = "";
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        await Loc.InitAsync();
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.LanguageChanged += _locHandler;

        var apiBase = Config["ApiBaseUrl"]?.TrimEnd('/') ?? "";
        var returnUrl = Nav.BaseUri.TrimEnd('/') + "/auth/callback";
        LoginUrl = $"{apiBase}/api/auth/google?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private async Task SwitchLangAsync(string lang) => await Loc.SetLangAsync(lang);

    public void Dispose() => Loc.LanguageChanged -= _locHandler;
}
