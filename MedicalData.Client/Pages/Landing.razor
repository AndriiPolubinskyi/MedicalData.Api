@page "/"
@layout BlankLayout
@inject NavigationManager Nav
@inject LocalizationService Loc
@inject AuthService Auth
@implements IDisposable

<!-- ── Nav ──────────────────────────────────────────────── -->
<nav class="lp-nav">
    <div class="lp-container lp-nav-inner">
        <a href="/" class="lp-brand">
            <div class="nav-brand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/>
                </svg>
            </div>
            @Loc["brand"]
        </a>
        <div class="lp-nav-right">
            <a href="/demo" class="lp-nav-link">@Loc["demo.try"]</a>
            <div class="lang-switcher">
                <button class="lang-btn @(Loc.Lang == "uk" ? "active" : "")" @onclick='() => SwitchLangAsync("uk")'>UA</button>
                <button class="lang-btn @(Loc.Lang == "en" ? "active" : "")" @onclick='() => SwitchLangAsync("en")'>EN</button>
                <button class="lang-btn @(Loc.Lang == "ru" ? "active" : "")" @onclick='() => SwitchLangAsync("ru")'>RU</button>
            </div>
            <a href="/login" class="nav-signin-btn">@Loc["login.google.short"]</a>
        </div>
    </div>
</nav>

<!-- ── Hero ─────────────────────────────────────────────── -->
<section class="lp-hero">
    <div class="lp-container lp-hero-inner">
        <div class="lp-hero-content">
            <div class="hero-eyebrow">@Loc["hero.eyebrow"]</div>
            <h1 class="lp-hero-title">
                @Loc["landing.hero.title"]<br>
                <span>@Loc["landing.hero.title.accent"]</span>
            </h1>
            <p class="lp-hero-sub">@Loc["landing.hero.sub"]</p>
            <div class="lp-hero-actions">
                <a href="/login" class="btn-hero">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                    @Loc["landing.hero.cta"]
                </a>
                <a href="/demo" class="btn-ghost">@Loc["demo.try"] →</a>
            </div>
            <p class="hero-labs">@Loc["landing.hero.labs"]</p>
        </div>

        <div class="lp-hero-visual">
            <div class="hero-glow"></div>
            <div class="hero-pdf-card">
                <div class="hero-pdf-header">
                    <div class="hero-pdf-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                        </svg>
                    </div>
                    <div>
                        <div class="hero-pdf-title">@Loc["landing.demo.title"]</div>
                        <div class="hero-pdf-sub">Synevo · @Loc["landing.demo.date"]</div>
                    </div>
                </div>
                <div class="hero-metric-row">
                    <span class="hero-metric-name">@Loc["landing.demo.m1"]</span>
                    <span class="hero-metric-val ok">142 г/л</span>
                </div>
                <div class="hero-metric-row">
                    <span class="hero-metric-name">@Loc["landing.demo.m2"]</span>
                    <span class="hero-metric-val warn">9.8 ×10⁹</span>
                </div>
                <div class="hero-metric-row">
                    <span class="hero-metric-name">@Loc["landing.demo.m3"]</span>
                    <span class="hero-metric-val ok">4.9 ммоль/л</span>
                </div>
                <div class="hero-metric-row">
                    <span class="hero-metric-name">@Loc["landing.demo.m4"]</span>
                    <span class="hero-metric-val err">8 нг/мл</span>
                </div>
            </div>
            <div class="hero-float-badge badge-ai">
                <div class="badge-label">@Loc["hero.badge.ai"]</div>
                <div class="badge-val" style="font-size:11px;line-height:1.4;max-width:110px;">@Loc["landing.demo.ai"]</div>
            </div>
            <div class="hero-float-badge badge-ok">
                <div class="badge-label">@Loc["hero.badge.norm"]</div>
                <div class="badge-val" style="color:var(--success)">3 / 4</div>
            </div>
            <div class="hero-float-badge badge-warn">
                <div class="badge-label">@Loc["landing.demo.warn"]</div>
                <div class="badge-val" style="color:var(--warning);font-size:12px;">↑ @Loc["landing.demo.m2"]</div>
            </div>
        </div>
    </div>
</section>

<!-- ── Trust bar ─────────────────────────────────────────── -->
<div class="lp-trust">
    <div class="lp-container lp-trust-inner">
        <span class="lp-trust-label">@Loc["landing.trust.label"]</span>
        <div class="lp-trust-logos">
            <span>Synevo</span>
            <span>Діла</span>
            <span>CSD</span>
            <span>Invivo</span>
            <span>ADONIS</span>
            <span class="lp-trust-more">@Loc["landing.trust.more"]</span>
        </div>
    </div>
</div>

<!-- ── How it works ──────────────────────────────────────── -->
<section class="lp-section">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="hero-eyebrow">@Loc["landing.how.eyebrow"]</div>
            <h2 class="lp-section-title">@Loc["landing.how.title"]</h2>
        </div>
        <div class="lp-steps">
            <div class="lp-step">
                <div class="lp-step-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                </div>
                <div class="lp-step-num">1</div>
                <h3 class="lp-step-title">@Loc["landing.step1.title"]</h3>
                <p class="lp-step-sub">@Loc["landing.step1.sub"]</p>
            </div>
            <div class="lp-step-connector">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
            </div>
            <div class="lp-step">
                <div class="lp-step-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                </div>
                <div class="lp-step-num">2</div>
                <h3 class="lp-step-title">@Loc["landing.step2.title"]</h3>
                <p class="lp-step-sub">@Loc["landing.step2.sub"]</p>
            </div>
            <div class="lp-step-connector">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
            </div>
            <div class="lp-step">
                <div class="lp-step-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                    </svg>
                </div>
                <div class="lp-step-num">3</div>
                <h3 class="lp-step-title">@Loc["landing.step3.title"]</h3>
                <p class="lp-step-sub">@Loc["landing.step3.sub"]</p>
            </div>
        </div>
    </div>
</section>

<!-- ── Features ──────────────────────────────────────────── -->
<section class="lp-section lp-features-section">
    <div class="lp-container">
        <div class="lp-section-head">
            <div class="hero-eyebrow">@Loc["landing.features.eyebrow"]</div>
            <h2 class="lp-section-title">@Loc["landing.features.title"]</h2>
        </div>
        <div class="lp-features">
            <div class="lp-feature card-sm">
                <div class="lp-feature-icon lp-feature-icon--accent">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                </div>
                <h3 class="lp-feature-title">@Loc["landing.f1.title"]</h3>
                <p class="lp-feature-sub">@Loc["landing.f1.sub"]</p>
            </div>
            <div class="lp-feature card-sm">
                <div class="lp-feature-icon lp-feature-icon--success">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                    </svg>
                </div>
                <h3 class="lp-feature-title">@Loc["landing.f2.title"]</h3>
                <p class="lp-feature-sub">@Loc["landing.f2.sub"]</p>
            </div>
            <div class="lp-feature card-sm">
                <div class="lp-feature-icon lp-feature-icon--warning">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                    </svg>
                </div>
                <h3 class="lp-feature-title">@Loc["landing.f3.title"]</h3>
                <p class="lp-feature-sub">@Loc["landing.f3.sub"]</p>
            </div>
            <div class="lp-feature card-sm">
                <div class="lp-feature-icon lp-feature-icon--muted">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                </div>
                <h3 class="lp-feature-title">@Loc["landing.f4.title"]</h3>
                <p class="lp-feature-sub">@Loc["landing.f4.sub"]</p>
            </div>
        </div>
    </div>
</section>

<!-- ── CTA ───────────────────────────────────────────────── -->
<section class="lp-cta">
    <div class="lp-container lp-cta-inner">
        <div class="lp-cta-glow"></div>
        <h2 class="lp-cta-title">@Loc["landing.cta.title"]</h2>
        <p class="lp-cta-sub">@Loc["landing.cta.sub"]</p>
        <a href="/login" class="btn-hero">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            @Loc["landing.cta.btn"]
        </a>
        <a href="/demo" class="lp-cta-demo">@Loc["landing.cta.demo"]</a>
    </div>
</section>

<!-- ── Footer ────────────────────────────────────────────── -->
<footer class="lp-footer">
    <div class="lp-container lp-footer-inner">
        <span class="lp-footer-copy">© 2025 @Loc["brand"]</span>
        <nav class="lp-footer-links">
            <a href="/demo">@Loc["demo.try"]</a>
            <a href="/login">@Loc["login.google.short"]</a>
        </nav>
    </div>
</footer>

@code {
    private Action? _locHandler;

    protected override async Task OnInitializedAsync()
    {
        await Loc.InitAsync();
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.LanguageChanged += _locHandler;

        if (await Auth.IsAuthenticatedAsync())
            Nav.NavigateTo("/app");
    }

    private async Task SwitchLangAsync(string lang) => await Loc.SetLangAsync(lang);

    public void Dispose() => Loc.LanguageChanged -= _locHandler;
}
