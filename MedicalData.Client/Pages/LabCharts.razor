    private static string GetLabGroup(string name)
    {
        var n = name.ToLowerInvariant();
        if (n.Contains("холестерин") || n.Contains("тригліцерид") || n.Contains("ліпо") ||
            n.Contains("лпвщ") || n.Contains("лпнщ") || n.Contains("лпднщ") ||
            n.Contains("hdl") || n.Contains("ldl") || n.Contains("vldl") ||
            n.Contains("chol") || n.Contains("атероген") || n.Contains("non-hdl") ||
            n.Contains("не-лпвщ") || n.Contains("non–hdl"))
            return "Ліпідограма";

        if (n.Contains("гемоглобін") || n.Contains("еритроцит") || n.Contains("лейкоцит") ||
            n.Contains("тромбоцит") || n.Contains("гематокрит") || n.Contains("шое") ||
            n.Contains("лімфоцит") || n.Contains("моноцит") || n.Contains("базофіл") ||
            n.Contains("еозинофіл") || n.Contains("сегментоядерн") || n.Contains("паличкоядерн") ||
            n.Contains("метамієлоцит") || n.Contains("мієлоцит") || n.Contains("тромбокрит") ||
            n.Contains("плазматичн") || n.Contains("вірoцит") ||
            n.Contains("hgb") || n.Contains("rbc") || n.Contains("wbc") || n.Contains("plt") ||
            n.Contains("hct") || n.Contains("esr") || n.Contains("mcv") || n.Contains("mch") ||
            n.Contains("rdw") || n.Contains("mpv") || n.Contains("pct") || n.Contains("pdw") ||
            n.Contains("ly%") || n.Contains("mo%") || n.Contains("ba%") || n.Contains("eo%") ||
            n.Contains("ne%"))
            return "Загальний аналіз крові";

        if (n.Contains("глюкоза") || n.Contains("білок") || n.Contains("білірубін") ||
            n.Contains("алт") || n.Contains("аст") || n.Contains("лужна фосфатаза") ||
            n.Contains("ггт") || n.Contains("лактатдегідрогеназа") ||
            n.Contains("alt") || n.Contains("ast") || n.Contains("alp") || n.Contains("ggt") ||
            n.Contains("ldh") || n.Contains("glu") || n.Contains("glucose") ||
            n.Contains("tbil") || n.Contains("dbil") || n.Contains("ibil"))
            return "Біохімія";

        if (n.Contains("інсулін") || n.Contains("глікозильован") || n.Contains("hba1c") ||
            n.Contains("нома") || n.Contains("пептид") || n.Contains("тестостерон") ||
            n.Contains("лютеїнізуючий") || n.Contains("глобулін") || n.Contains("fai") ||
            n.Contains("testosterone") || n.Contains("insulin"))
            return "Гормони та ендокринологія";

        if (n.Contains("пса") || n.Contains("psa") || n.Contains("простат"))
            return "Онкомаркери";

        if (n.Contains("хелікобактер") || n.Contains("helicobacter") ||
            n.Contains("антитіл") || n.Contains("вірус") || n.Contains("інфекц"))
            return "Інфекційна серологія";

        return "Інше";
    }

    private static int LabGroupOrder(string g) => g switch
    {
        "Загальний аналіз крові"    => 0,
        "Ліпідограма"               => 1,
        "Біохімія"                  => 2,
        "Гормони та ендокринологія" => 3,
        "Онкомаркери"               => 4,
        "Інфекційна серологія"      => 5,
        _                           => 99
    };

    private void DiscardParsed()
    {
        parsedResults = null;
        selectedFile = null;
        uploadMsg = null;
        uploadAiSummary = null;
        displayExplainTexts.Clear();
        showFullSummary = false;
    }

