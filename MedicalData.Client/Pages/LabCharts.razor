@page "/"
@layout BlankLayout
@implements IDisposable
@using MedicalData.Client.Models
@using Plotly.Blazor
@using Plotly.Blazor.LayoutLib
@using Plotly.Blazor.Traces
@using System.Security.Claims
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthService Auth
@inject AuthStateProvider AuthState
@inject LocalizationService Loc
@attribute [Authorize]

<div class="app">

    <!-- ── Topbar ────────────────────────────────────────── -->
    <header class="topbar">
        <div class="topbar-inner">
            <div class="brand">🩺 @Loc["brand"]</div>

            <nav class="tab-nav">
                <button class="tab-pill @Active(Tab.Dashboard)" @onclick="() => tab = Tab.Dashboard">🏠 @Loc["tab.dashboard"]</button>
                <button class="tab-pill @Active(Tab.Upload)"    @onclick="() => tab = Tab.Upload">📄 @Loc["tab.upload"]</button>
                <button class="tab-pill @Active(Tab.History)"   @onclick="() => tab = Tab.History">📅 @Loc["tab.history"]</button>
                <button class="tab-pill @Active(Tab.Charts)"    @onclick="() => tab = Tab.Charts">📈 @Loc["tab.charts"]</button>
            </nav>

            <div class="topbar-right">
                <div class="lang-switcher">
                    <button class="lang-btn @(Loc.Lang == "uk" ? "active" : "")" @onclick='() => SwitchLangAsync("uk")'>UA</button>
                    <button class="lang-btn @(Loc.Lang == "en" ? "active" : "")" @onclick='() => SwitchLangAsync("en")'>EN</button>
                    <button class="lang-btn @(Loc.Lang == "ru" ? "active" : "")" @onclick='() => SwitchLangAsync("ru")'>RU</button>
                </div>
                @if (userPic != null)
                {
                    <img src="@userPic" class="user-avatar" alt="" />
                }
                @if (userName != null)
                {
                    <span class="topbar-username">@userName</span>
                }
                <button class="logout-btn" @onclick="LogoutAsync">@Loc["logout"]</button>
            </div>
        </div>
    </header>

    <!-- ── Main content ──────────────────────────────────── -->
    <main class="main-wrap">

        @if (loadError != null)
        {
            <div style="background:#fef2f2;border:1px solid #fca5a5;border-radius:10px;padding:14px 16px;color:#991b1b;margin-bottom:20px;">
                ⚠ @loadError
            </div>
        }

        <!-- ══════════════════════════════════════════
             DASHBOARD
             ══════════════════════════════════════════ -->
        @if (tab == Tab.Dashboard)
        {
            @if (historyByDate is null)
            {
                <div class="loading-row"><FluentProgressRing Style="width:22px;height:22px;" /> @Loc["loading"]</div>
            }
            else if (historyByDate.Count == 0)
            {
                <div class="card" style="text-align:center;padding:48px 24px;">
                    <div style="font-size:52px;margin-bottom:14px;">🩺</div>
                    <p style="color:#475569;font-size:15px;margin:0 0 20px;">@Loc["empty.noData"]</p>
                    <button class="ai-btn" @onclick="() => tab = Tab.Upload">@Loc["empty.upload"]</button>
                </div>
            }
            else
            {
                <div class="dash-grid">
                    <div class="stat-card">
                        <div class="stat-label">@Loc["stat.lastDate"]</div>
                        <div class="stat-value" style="font-size:17px;">@lastDateStr</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">@Loc["stat.totalCount"]</div>
                        <div class="stat-value">@totalCount</div>
                    </div>
                    <div class="@(abnormalCount > 0 ? "stat-card stat-card-warn" : "stat-card")">
                        <div class="stat-label">@Loc["stat.abnCount"]</div>
                        <div class="stat-value">@(abnormalCount > 0 ? $"⚠ {abnormalCount}" : Loc["stat.normal"])</div>
                    </div>
                </div>

                @if (categoryCards is { Count: > 0 })
                {
                    <p class="section-title">@Loc["section.categories"]</p>
                    <div class="cat-grid">
                        @foreach (var cat in categoryCards)
                        {
                            <div class="cat-card @(cat.HasAbnormal ? "cat-card-warn" : "")"
                                 @onclick="() => OpenCategoryHistory(cat.Name)">
                                <div class="cat-header">
                                    <div class="cat-icon-bubble" style="@CatBubbleStyle(cat.Name)">@cat.Icon</div>
                                    <div class="cat-info">
                                        <div class="cat-name">@Loc.GetGroupName(cat.Name)</div>
                                        <div class="cat-date">@Loc.FormatDate(cat.LastDate)</div>
                                    </div>
                                </div>
                                <div class="cat-footer">
                                    <span style="font-size:11px;color:#64748b;">@cat.Count @Loc["cat.count"]</span>
                                    @if (cat.AbnormalCount > 0)
                                    {
                                        <span class="chip chip-warn" style="font-size:10px;padding:1px 6px;">⚠ @cat.AbnormalCount</span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-ok" style="font-size:10px;padding:1px 6px;">✓</span>
                                    }
                                </div>
                                <svg class="sparkline" viewBox="0 0 100 30" preserveAspectRatio="none">
                                    <polyline points="@cat.SparkPoints"
                                              fill="none"
                                              stroke="@(cat.HasAbnormal ? "#f59e0b" : GetCatColors(cat.Name).fg)"
                                              stroke-width="2.5"
                                              stroke-linejoin="round"
                                              stroke-linecap="round" />
                                </svg>
                            </div>
                        }
                    </div>
                }

                <p class="section-title">@Loc["section.aiSummary"]</p>
                <button class="ai-btn" @onclick="GetDashAiSummaryAsync" disabled="@isDashAiLoading">
                    @(isDashAiLoading ? Loc["ai.loading"] : Loc["ai.btn"])
                </button>
                @if (isDashAiLoading)
                {
                    <div class="ai-card loading-row" style="margin-top:12px;">
                        <FluentProgressRing Style="width:18px;height:18px;" /> @Loc["generating"]
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(dashAiSummary))
                {
                    <div class="ai-card" style="margin-top:12px;">
                        <div class="ai-card-header">@Loc["ai.header"]</div>
                        <div class="ai-card-body">@dashAiSummary</div>
                    </div>
                }
            }
        }

        <!-- ══════════════════════════════════════════
             UPLOAD
             ══════════════════════════════════════════ -->
        @if (tab == Tab.Upload)
        {
            <div class="card">
                <h2 class="card-title">@Loc["upload.title"]</h2>

                <label class="drop-zone">
                    <div class="dz-icon">📎</div>
                    <div class="dz-label">@(selectedFile?.Name ?? Loc["upload.choose"])</div>
                    <div class="dz-hint">@Loc["upload.hint"]</div>
                    <InputFile OnChange="OnFileSelected" accept=".pdf,application/pdf"
                               style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;" />
                </label>

                <div class="row-gap" style="margin-top:16px;">
                    <FluentButton Appearance="Appearance.Accent" OnClick="ParsePdfAsync"
                                  Disabled="@(selectedFile is null || isParsing)" Style="min-width:160px;">
                        @(isParsing ? Loc["upload.parsing"] : Loc["upload.parse"])
                    </FluentButton>
                    @if (parsedResults is { Count: > 0 })
                    {
                        <FluentButton Appearance="Appearance.Outline" OnClick="SaveAsync"
                                      Disabled="@isSaving" Style="min-width:160px;">
                            @(isSaving ? Loc["upload.saving"] : Loc["upload.save"])
                        </FluentButton>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(uploadMsg))
                {
                    <p class="@(uploadError ? "msg-error" : "msg-ok")" style="margin-top:10px;">@uploadMsg</p>
                }

                @if (parsedResults is { Count: > 0 })
                {
                    <div class="summary-bar">
                        <span>📅 <strong>@Loc.FormatDate(parsedDate ?? DateTime.Today)</strong></span>
                        <span class="chip chip-ok">@parsedResults.Count @Loc["tbl.indicator"]</span>
                        @if (parsedResults.Any(x => x.IsAbnormal))
                        {
                            <span class="chip chip-warn">⚠ @parsedResults.Count(x => x.IsAbnormal)</span>
                        }
                    </div>

                    <div style="overflow-x:auto; margin-top:12px;">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@Loc["tbl.indicator"]</th>
                                    <th class="right">@Loc["tbl.value"]</th>
                                    <th>@Loc["tbl.unit"]</th>
                                    <th>@Loc["tbl.range"]</th>
                                    <th class="center">⚠</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in parsedResults.OrderBy(x => x.TestName))
                                {
                                    <tr class="@(m.IsAbnormal ? "row-warn" : "")">
                                        <td>@m.TestName</td>
                                        <td class="right @(m.IsAbnormal ? "val-warn" : "val-ok")">@m.Value.ToString("G6")</td>
                                        <td class="muted">@m.Unit</td>
                                        <td class="muted">@m.ReferenceRange</td>
                                        <td class="center">@(m.IsAbnormal ? "⚠️" : "✓")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div style="margin-top:14px;">
                        <button class="ai-btn" @onclick="GetUploadAiSummaryAsync" disabled="@isUploadAiLoading">
                            @(isUploadAiLoading ? Loc["ai.loading"] : Loc["ai.analyze"])
                        </button>
                    </div>

                    @if (isUploadAiLoading)
                    {
                        <div class="ai-card loading-row" style="margin-top:12px;">
                            <FluentProgressRing Style="width:18px;height:18px;" /> @Loc["generating"]
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(uploadAiSummary))
                    {
                        <div class="ai-card">
                            <div class="ai-card-header">@Loc["ai.header"]</div>
                            <div class="ai-card-body">@uploadAiSummary</div>
                        </div>
                    }
                }
            </div>
        }

        <!-- ══════════════════════════════════════════
             HISTORY
             ══════════════════════════════════════════ -->
        @if (tab == Tab.History)
        {
            <div class="card">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;padding-bottom:14px;border-bottom:1px solid #f1f5f9;flex-wrap:wrap;gap:8px;">
                    <h2 style="margin:0;font-size:17px;font-weight:700;color:#1e293b;">@Loc["history.title"]</h2>
                    <div style="display:flex;gap:8px;">
                        <button class="ai-btn" @onclick='() => OpenShare("latest")'>@Loc["share.latest"]</button>
                        <button class="ai-btn" @onclick='() => OpenShare("all")'>@Loc["share.all"]</button>
                    </div>
                </div>

                @if (filterCategory != null)
                {
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:8px 12px;">
                        <span style="font-size:13px;color:#1d4ed8;">🔍 @Loc["filter.label"] <strong>@Loc.GetGroupName(filterCategory)</strong></span>
                        <button @onclick="() => filterCategory = null"
                                style="margin-left:auto;background:none;border:none;cursor:pointer;color:#64748b;font-size:16px;line-height:1;padding:0 2px;">✕</button>
                    </div>
                }

                @if (shareUrl != null)
                {
                    <div class="ai-card" style="margin-bottom:16px;">
                        <div class="ai-card-header">🔗 @(shareScope == "latest" ? Loc["share.latestScope"] : Loc["share.allScope"])</div>
                        <div class="ai-card-body" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                            <code style="flex:1;word-break:break-all;">@shareUrl</code>
                            <button class="ai-btn" @onclick="CopyShare">@Loc["share.copy"]</button>
                            <button class="ai-btn" @onclick="() => shareUrl = null">✕</button>
                        </div>
                    </div>
                }

                @if (historyByDate is null)
                {
                    <div class="loading-row"><FluentProgressRing Style="width:22px;height:22px;" /> @Loc["loading"]</div>
                }
                else
                {
                    var displayHistory = filterCategory is null
                        ? historyByDate
                        : historyByDate
                            .Select(kv => new KeyValuePair<DateTime, List<LabResult>>(
                                kv.Key,
                                kv.Value.Where(r => GetLabGroup(r.TestName) == filterCategory).ToList()))
                            .Where(kv => kv.Value.Count > 0)
                            .ToDictionary(kv => kv.Key, kv => kv.Value);

                    @if (displayHistory.Count == 0)
                    {
                        <p class="muted">@(filterCategory != null
                            ? Loc.Format("history.emptyCategory", Loc.GetGroupName(filterCategory))
                            : Loc["history.empty"])</p>
                    }
                    else
                    {
                        var byYear = displayHistory
                            .OrderByDescending(kv => kv.Key)
                            .GroupBy(kv => kv.Key.Year)
                            .ToList();

                        @foreach (var yearGroup in byYear)
                        {
                            <div class="tl-year-block">
                                <div class="tl-year-header">@yearGroup.Key</div>
                                <div class="tl-table">
                                    <div class="tl-col-head">
                                        <span class="tl-col-date">@Loc["col.date"]</span>
                                        <span class="tl-col-count">@Loc["col.indicators"]</span>
                                        <span class="tl-col-warn">@Loc["col.deviations"]</span>
                                        <span class="tl-col-actions"></span>
                                    </div>

                                    @foreach (var (date, items) in yearGroup.OrderByDescending(kv => kv.Key))
                                    {
                                        var isOpen     = openDates.Contains(date);
                                        var abnCount   = items.Count(x => x.IsAbnormal);
                                        var hasSumm    = aiSummaries.TryGetValue(date, out var summ);
                                        var isLoading  = loadingAi.Contains(date);
                                        var isDeleting = deletingDates.Contains(date);

                                        <div class="tl-row @(isOpen ? "tl-row-open" : "")" @onclick="() => ToggleDate(date)">
                                            <span class="tl-col-date">
                                                <span class="tl-chevron">@(isOpen ? "▾" : "▸")</span>
                                                @Loc.ShortDate(date)
                                            </span>
                                            <span class="tl-col-count">
                                                <span class="chip chip-ok">@items.Count</span>
                                            </span>
                                            <span class="tl-col-warn">
                                                @if (abnCount > 0)
                                                {
                                                    <span class="chip chip-warn">⚠ @abnCount</span>
                                                }
                                                else
                                                {
                                                    <span class="tl-ok-mark">✓</span>
                                                }
                                            </span>
                                            <span class="tl-col-actions" @onclick:stopPropagation="true" style="display:flex;gap:4px;">
                                                <button class="ai-btn" @onclick="() => GetAiSummaryAsync(date, items)"
                                                        disabled="@isLoading">
                                                    @(isLoading ? "⏳" : Loc["ai.short"])
                                                </button>
                                                <button class="ai-btn" style="color:#dc2626;"
                                                        @onclick="() => DeleteByDateAsync(date)"
                                                        disabled="@isDeleting" title="@Loc.Format("delete.confirm", Loc.ShortDate(date), date.Year)">
                                                    @(isDeleting ? "⏳" : "🗑️")
                                                </button>
                                            </span>
                                        </div>

                                        @if (isOpen)
                                        {
                                            <div class="tl-detail">
                                                <div style="overflow-x:auto;">
                                                    <table class="data-table compact">
                                                        <thead>
                                                            <tr>
                                                                <th>@Loc["tbl.indicator"]</th>
                                                                <th class="right">@Loc["tbl.value"]</th>
                                                                <th>@Loc["tbl.unit"]</th>
                                                                <th>@Loc["tbl.range"]</th>
                                                                <th class="center">⚠</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var r in items.OrderBy(x => x.TestName))
                                                            {
                                                                <tr class="@(r.IsAbnormal ? "row-warn" : "")">
                                                                    <td>@r.TestName</td>
                                                                    <td class="right @(r.IsAbnormal ? "val-warn" : "")">@r.Value.ToString("G6")</td>
                                                                    <td class="muted">@r.Unit</td>
                                                                    <td class="muted">@r.ReferenceRange</td>
                                                                    <td class="center">@(r.IsAbnormal ? "⚠️" : "✓")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>

                                                @if (isLoading)
                                                {
                                                    <div class="ai-card loading-row" style="margin-top:12px;">
                                                        <FluentProgressRing Style="width:18px;height:18px;" /> @Loc["generating"]
                                                    </div>
                                                }
                                                else if (hasSumm && !string.IsNullOrWhiteSpace(summ))
                                                {
                                                    <div class="ai-card">
                                                        <div class="ai-card-header">@Loc["ai.header"]</div>
                                                        <div class="ai-card-body">@summ</div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        }

        <!-- ══════════════════════════════════════════
             CHARTS
             ══════════════════════════════════════════ -->
        @if (tab == Tab.Charts)
        {
            <div class="card">
                <h2 class="card-title">@Loc["charts.title"]</h2>

                @if (labTypes is null)
                {
                    <div class="loading-row"><FluentProgressRing Style="width:22px;height:22px;" /> @Loc["loading"]</div>
                }
                else if (labTypes.Count == 0)
                {
                    <p class="muted">@Loc["charts.empty"]</p>
                }
                else
                {
                    <select class="select-test" @onchange="OnTestSelected">
                        <option value="">@Loc["charts.select"]</option>
                        @if (labTypeGroups != null)
                        {
                            @foreach (var (group, names) in labTypeGroups)
                            {
                                <optgroup label="@Loc.GetGroupName(group)">
                                    @foreach (var name in names)
                                    {
                                        <option value="@name">@name</option>
                                    }
                                </optgroup>
                            }
                        }
                    </select>

                    @if (chart != null)
                    {
                        <div style="margin-top:16px;">
                            <PlotlyChart Config="@chart.Config" Layout="@chart.Layout"
                                         Data="@chart.Data" @ref="chart" @key="chartVersion" />
                        </div>
                    }
                }
            </div>
        }

    </main>

    <!-- ── Mobile bottom nav ─────────────────────────────── -->
    <nav class="mob-bottom-nav">
        <button class="mob-tab @Active(Tab.Dashboard)" @onclick="() => tab = Tab.Dashboard">
            <span class="mob-tab-icon">🏠</span>
            <span>@Loc["tab.dashboard"]</span>
        </button>
        <button class="mob-tab @Active(Tab.Upload)" @onclick="() => tab = Tab.Upload">
            <span class="mob-tab-icon">📄</span>
            <span>@Loc["tab.upload"]</span>
        </button>
        <button class="mob-tab @Active(Tab.History)" @onclick="() => tab = Tab.History">
            <span class="mob-tab-icon">📅</span>
            <span>@Loc["tab.history"]</span>
        </button>
        <button class="mob-tab @Active(Tab.Charts)" @onclick="() => tab = Tab.Charts">
            <span class="mob-tab-icon">📈</span>
            <span>@Loc["tab.charts"]</span>
        </button>
    </nav>

</div>

@code {
    private enum Tab { Dashboard, Upload, History, Charts }
    private Tab tab = Tab.Dashboard;
    private string Active(Tab t) => tab == t ? "active" : "";

    // ── User info ─────────────────────────────────────
    private string? userName;
    private string? userPic;

    // ── Dashboard ─────────────────────────────────────
    private List<CategoryCard>? categoryCards;
    private string? dashAiSummary;
    private bool isDashAiLoading;
    private string? lastDateStr;
    private int totalCount;
    private int abnormalCount;

    // ── Upload ────────────────────────────────────────
    private const long MaxBytes = 5 * 1024 * 1024;
    private IBrowserFile? selectedFile;
    private bool isParsing, isSaving, isUploadAiLoading;
    private string? uploadMsg;
    private bool uploadError;
    private List<ParsedLabMetric>? parsedResults;
    private DateTime? parsedDate;
    private string? uploadAiSummary;

    // ── History ───────────────────────────────────────
    private Dictionary<DateTime, List<LabResult>>? historyByDate;
    private HashSet<DateTime> openDates = new();
    private Dictionary<DateTime, string?> aiSummaries = new();
    private HashSet<DateTime> loadingAi = new();
    private HashSet<DateTime> deletingDates = new();
    private string? filterCategory;
    private string? shareUrl;
    private string? shareScope;

    // ── Charts ────────────────────────────────────────
    private List<string>? labTypes;
    private Dictionary<string, List<string>>? labTypeGroups;
    private PlotlyChart? chart;
    private int chartVersion;

    // ── Error state ───────────────────────────────────
    private string? loadError;

    // ── Localization ──────────────────────────────────
    private Action? _locHandler;

    public void Dispose() => Loc.LanguageChanged -= _locHandler;

    private async Task SwitchLangAsync(string lang)
    {
        await Loc.SetLangAsync(lang);
        // Refresh date strings
        var lastDate = historyByDate?.Keys.OrderByDescending(d => d).FirstOrDefault();
        lastDateStr = lastDate.HasValue && lastDate != default ? Loc.FormatDate(lastDate.Value) : null;
    }

    // ── Init ──────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await Loc.InitAsync();
        _locHandler = () => InvokeAsync(StateHasChanged);
        Loc.LanguageChanged += _locHandler;

        try { await Task.WhenAll(LoadHistoryAsync(), LoadLabTypesAsync()); }
        catch (Exception ex) { loadError = ex.Message; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var user = await Auth.GetUserAsync();
            if (user.Identity?.IsAuthenticated == true)
            {
                userName = user.FindFirst(ClaimTypes.Name)?.Value;
                userPic  = user.FindFirst("picture")?.Value;
                StateHasChanged();
            }
        }
        catch { }
    }

    // ── Data loading ──────────────────────────────────
    private async Task LoadHistoryAsync()
    {
        var all = await Http.GetFromJsonAsync<List<LabResult>>("/api/LabResult");
        historyByDate = (all ?? [])
            .GroupBy(r => r.TestDate.Date)
            .ToDictionary(g => g.Key, g => g.ToList());

        var allResults = historyByDate.SelectMany(kv => kv.Value).ToList();
        totalCount = allResults.Select(r => r.TestName).Distinct().Count();
        var lastDate = historyByDate.Keys.OrderByDescending(d => d).FirstOrDefault();
        lastDateStr = lastDate == default ? null : Loc.FormatDate(lastDate);
        abnormalCount = lastDate == default ? 0 : historyByDate[lastDate].Count(r => r.IsAbnormal);
        categoryCards = ComputeCategoryCards();
    }

    private async Task LoadLabTypesAsync()
    {
        labTypes = await Http.GetFromJsonAsync<List<string>>("/api/LabResult/labtypes");
        if (labTypes != null)
        {
            labTypeGroups = labTypes
                .GroupBy(GetLabGroup)
                .OrderBy(g => LabGroupOrder(g.Key))
                .ToDictionary(g => g.Key, g => g.OrderBy(x => x).ToList());
        }
    }

    // ── Dashboard logic ───────────────────────────────
    private List<CategoryCard> ComputeCategoryCards()
    {
        if (historyByDate is null) return [];
        var allResults = historyByDate.SelectMany(kv => kv.Value).ToList();
        return allResults
            .GroupBy(r => GetLabGroup(r.TestName))
            .Select(g =>
            {
                var dates     = g.GroupBy(r => r.TestDate.Date).OrderBy(d => d.Key).ToList();
                var lastDate  = dates.Last().Key;
                var lastItems = dates.Last().ToList();
                var abnCount  = lastItems.Count(r => r.IsAbnormal);
                var count     = g.Select(r => r.TestName).Distinct().Count();
                var sparkVals = dates
                    .Select(d => (double)d.Count(r => r.IsAbnormal) / d.Count() * 100)
                    .ToList();
                return new CategoryCard(
                    g.Key, GetGroupIcon(g.Key), lastDate,
                    count, abnCount, abnCount > 0,
                    GenerateSparklinePoints(sparkVals));
            })
            .OrderBy(c => LabGroupOrder(c.Name))
            .ToList();
    }

    private static string GenerateSparklinePoints(List<double> values)
    {
        if (values.Count < 2) return "0,28 100,28";
        var min = values.Min(); var max = values.Max(); var range = max - min;
        return string.Join(" ", values.Select((v, i) =>
        {
            var x = (double)i / (values.Count - 1) * 100;
            var y = range == 0 ? 15.0 : 28.0 - (v - min) / range * 24.0;
            return $"{x:F1},{y:F1}";
        }));
    }

