@page "/"
@page "/demo"
@layout BlankLayout
@implements IDisposable
@using MedicalData.Client.Models
@using Plotly.Blazor
@using Plotly.Blazor.LayoutLib
@using Plotly.Blazor.Traces
@using System.Security.Claims
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthService Auth
@inject AuthStateProvider AuthState
@inject LocalizationService Loc
@inject ProfileService ProfileSvc
@inject ILogger<LabCharts> Logger
@using MedicalData.Client.Models

<div class="page-shell">

    @if (isInitializing)
    {
        <div class="page-loading-overlay">
            <FluentProgressRing Style="width:72px;height:72px;" />
        </div>
    }

    <!-- ══ NAV ══════════════════════════════════════════ -->
    <nav class="nav">
        <div class="nav-inner">
            <div class="nav-brand">
                <div class="nav-brand-icon">❤️</div>
                <span>Medical AI</span>
            </div>

            <div class="nav-links">
                <button class="nav-link @(pageView == PageView.Main    ? "active" : "")" @onclick="() => pageView = PageView.Main">@Loc["tab.dashboard"]</button>
                <button class="nav-link @(pageView == PageView.History ? "active" : "")" @onclick="() => pageView = PageView.History">@Loc["tab.history"]</button>
                <button class="nav-link @(pageView == PageView.Charts  ? "active" : "")" @onclick="() => pageView = PageView.Charts">@Loc["tab.charts"]</button>
            </div>

            <div class="nav-right">
                <div class="lang-switcher">
                    <button class="lang-btn @(Loc.Lang == "uk" ? "active" : "")" @onclick='() => SwitchLangAsync("uk")'>UA</button>
                    <button class="lang-btn @(Loc.Lang == "en" ? "active" : "")" @onclick='() => SwitchLangAsync("en")'>EN</button>
                    <button class="lang-btn @(Loc.Lang == "ru" ? "active" : "")" @onclick='() => SwitchLangAsync("ru")'>RU</button>
                </div>
                @if (!isDemo)
                {
                    @if (userPic != null)  { <img src="@userPic" class="user-avatar" alt="" @onclick="OpenProfile" style="cursor:pointer;" /> }
                    @if (userName != null) { <span class="nav-user-name">@userName</span> }
                    <button class="nav-profile-btn" @onclick="OpenProfile" title="Профіль">⚙</button>
                    <button class="nav-logout-btn" @onclick="LogoutAsync">@Loc["logout"]</button>
                }
                else
                {
                    <button class="nav-signin-btn" @onclick='() => Nav.NavigateTo("/login")'>@Loc["demo.login"] →</button>
                }
            </div>
        </div>
    </nav>

    <!-- ══ PROFILE MODAL ════════════════════════════════ -->
    @if (showProfileModal)
    {
        <div class="modal-overlay" @onclick="CloseProfile">
            <div class="modal-card" @onclick:stopPropagation>
                <div class="modal-header">
                    <span class="modal-title">⚙ @Loc["profile.title"]</span>
                    <button class="modal-close" @onclick="CloseProfile">✕</button>
                </div>

                <div class="modal-body">
                    <label class="field-label">@Loc["profile.sex"]</label>
                    <div class="sex-btns">
                        <button class="sex-btn @(profileEdit.Sex == "female" ? "active" : "")"
                                @onclick='() => { profileEdit.Sex = "female"; }'>♀ @Loc["profile.female"]</button>
                        <button class="sex-btn @(profileEdit.Sex == "male" ? "active" : "")"
                                @onclick='() => { profileEdit.Sex = "male"; }'>♂ @Loc["profile.male"]</button>
                    </div>

                    <label class="field-label" style="margin-top:16px;">@Loc["profile.birthdate"]</label>
                    <input class="field-input" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")"
                           value="@profileEdit.BirthDate"
                           @onchange='e => profileEdit.BirthDate = e.Value?.ToString()' />
                    @if (profileEdit.AgeYears.HasValue)
                    {
                        <span class="field-hint">@profileEdit.AgeYears @Loc["profile.years"]</span>
                    }

                    @if (profileEdit.Sex == "female")
                    {
                        <label class="field-label" style="margin-top:16px;">@Loc["profile.cycleday"]</label>
                        <input class="field-input" type="number" min="1" max="28" placeholder="1–28"
                               value="@profileEdit.CycleDay"
                               @onchange='e => profileEdit.CycleDay = int.TryParse(e.Value?.ToString(), out var d) ? d : null' />
                        <span class="field-hint">@Loc["profile.cycleday.hint"]</span>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn-primary" @onclick="SaveProfileAsync" disabled="@profileSaving">
                        @(profileSaving ? Loc["upload.saving"] : Loc["profile.save"])
                    </button>
                    @if (profileSaved)
                    {
                        <span class="profile-saved-msg">✓ @Loc["profile.saved"]</span>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ══ PAYWALL MODAL ════════════════════════════════ -->
    @if (showPaywall)
    {
        <div class="modal-overlay" @onclick="() => showPaywall = false">
            <div class="modal-card paywall-card" @onclick:stopPropagation>
                <div class="paywall-icon">✨</div>
                <h2 class="paywall-title">@Loc["paywall.title"]</h2>
                <p class="paywall-sub">@Loc["paywall.sub"]</p>
                <div class="paywall-plans">
                    <div class="paywall-plan">
                        <div class="paywall-plan-name">@Loc["paywall.pack3"]</div>
                        <div class="paywall-plan-price">99 ₴</div>
                        <div class="paywall-plan-hint">3 @Loc["paywall.credits"]</div>
                    </div>
                    <div class="paywall-plan paywall-plan--featured">
                        <div class="paywall-plan-badge">@Loc["paywall.popular"]</div>
                        <div class="paywall-plan-name">@Loc["paywall.pack10"]</div>
                        <div class="paywall-plan-price">249 ₴</div>
                        <div class="paywall-plan-hint">10 @Loc["paywall.credits"]</div>
                    </div>
                    <div class="paywall-plan">
                        <div class="paywall-plan-name">@Loc["paywall.pack25"]</div>
                        <div class="paywall-plan-price">499 ₴</div>
                        <div class="paywall-plan-hint">25 @Loc["paywall.credits"]</div>
                    </div>
                </div>
                <p class="paywall-contact">@Loc["paywall.contact"] <a href="mailto:polubin@gmail.com">polubin@gmail.com</a></p>
                <button class="btn-ghost" @onclick="() => showPaywall = false">@Loc["paywall.close"]</button>
            </div>
        </div>
    }

    <!-- ══ CONTENT ══════════════════════════════════════ -->
    <div class="page-content">

        @if (isDemo)
        {
            <div class="demo-banner">
                🔍 @Loc["demo.banner"]
                <a href="/login">@Loc["demo.login"] →</a>
            </div>
        }

        @if (loadError != null)
        {
            <div class="error-bar">⚠ @loadError</div>
        }

        <!-- ══ MAIN PAGE ══════════════════════════════════ -->
        @if (pageView == PageView.Main)
        {
            @if (historyByDate is null)
            {
                <!-- Loading -->
                <div class="loading-row"><FluentProgressRing Style="width:22px;height:22px;" /> @Loc["loading"]</div>
            }
            else if (!HasData)
            {
                <!-- ── HERO ────────────────────────────── -->
                <section class="hero">
                    <div class="hero-left">
                        <div class="hero-eyebrow">@Loc["hero.eyebrow"]</div>
                        <h1 class="hero-title">@Loc["hero.title"]</h1>
                        <p class="hero-sub">@Loc["hero.sub"]</p>
                        <div class="hero-actions">
                            @if (!isDemo)
                            {
                                @if (isParsing)
                                {
                                    <div class="loading-row" style="padding:14px 0;">
                                        <FluentProgressRing Style="width:22px;height:22px;" />
                                        @Loc["upload.parsing"]
                                    </div>
                                }
                                else
                                {
                                    <label class="btn-hero" style="cursor:pointer;position:relative;overflow:hidden;">
                                        @Loc["upload.parse"]
                                        <InputFile OnChange="OnFileSelected" accept=".pdf,application/pdf"
                                                   style="position:absolute;inset:0;opacity:0;cursor:pointer;" />
                                    </label>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(uploadMsg))
                            {
                                <p class="@(uploadError ? "msg-err" : "msg-ok")" style="margin-top:8px;">@uploadMsg</p>
                            }
                            <p class="hero-labs">Підтримуються Synevo, Діла, CSD, Invivo та інші лабораторії</p>
                        </div>
                    </div>

                    <div class="hero-visual">
                        <div class="hero-glow"></div>
                        <div class="hero-float-badge badge-warn">
                            <div class="badge-label">Холестерин</div>
                            <div class="badge-val" style="color:#F59E0B">6.4 ммоль/л ⚠</div>
                        </div>
                        <div class="hero-pdf-card">
                            <div class="hero-pdf-header">
                                <div class="hero-pdf-icon">📄</div>
                                <div>
                                    <div class="hero-pdf-title">Результати аналізів</div>
                                    <div class="hero-pdf-sub">Synevo • 15.01.2025</div>
                                </div>
                            </div>
                            <div class="hero-metric-row">
                                <span class="hero-metric-name">Гемоглобін</span>
                                <span class="hero-metric-val ok">138 г/л</span>
                            </div>
                            <div class="hero-metric-row">
                                <span class="hero-metric-name">Лейкоцити</span>
                                <span class="hero-metric-val warn">9.8 10⁹/л</span>
                            </div>
                            <div class="hero-metric-row">
                                <span class="hero-metric-name">АЛТ</span>
                                <span class="hero-metric-val err">52 Од/л</span>
                            </div>
                            <div class="hero-metric-row">
                                <span class="hero-metric-name">Глюкоза</span>
                                <span class="hero-metric-val ok">5.8 ммоль/л</span>
                            </div>
                        </div>
                        <div class="hero-float-badge badge-ai">
                            <div class="badge-label">@Loc["hero.badge.ai"]</div>
                            <div class="badge-val" style="color:#a5b4fc">Готовий ✓</div>
                        </div>
                        <div class="hero-float-badge badge-ok">
                            <div class="badge-label">@Loc["hero.badge.norm"]</div>
                            <div class="badge-val" style="color:#22C55E">24 показники ✓</div>
                        </div>
                    </div>
                </section>

            }
            else
            {
                <!-- ── DASHBOARD (historical data) ─────── -->

                <!-- ── UPLOAD STRIP ───────────────────── -->
                @if (!isDemo)
                {
                    <div class="upload-strip">
                        @if (isParsing)
                        {
                            <div class="loading-row" style="padding:0;">
                                <FluentProgressRing Style="width:18px;height:18px;" />
                                @Loc["upload.parsing"]
                            </div>
                        }
                        else
                        {
                            <span class="upload-strip-hint">@Loc["upload.strip.hint"]</span>
                            <label class="btn-primary btn-upload-label">
                                @Loc["upload.strip.btn"]
                                <InputFile OnChange="OnFileSelected" accept=".pdf,application/pdf"
                                           style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;" />
                            </label>
                        }
                    </div>
                }

                <!-- ── STATS ──────────────────────────── -->
                <div class="stats-row" style="margin-bottom:28px;">
                    <div class="stat-card">
                        <div class="stat-label">@Loc["stat.lastDate"]</div>
                        <div class="stat-value" style="font-size:18px;">@(CurrentDate.HasValue ? Loc.FormatDate(CurrentDate.Value) : "—")</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">@Loc["stat.totalCount"]</div>
                        <div class="stat-value">@CurrentItems?.Count</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">@Loc["stat.abnCount"]</div>
                        <div class="stat-value @(CurrentAbnormal?.Count > 0 ? "warn" : "ok")">
                            @(CurrentAbnormal?.Count > 0 ? $"⚠ {CurrentAbnormal.Count}" : Loc["stat.normal"])
                        </div>
                    </div>
                </div>

                <!-- ── AI CONCLUSION ──────────────────── -->
                <div class="ai-conclusion-card">
                    <div class="ai-conclusion-header">
                        <div class="ai-conclusion-icon" style="font-size:13px;font-weight:700;letter-spacing:-.02em;">AI</div>
                        <div class="ai-conclusion-title">@Loc["ai.conclusion"]</div>
                        <div class="ai-conclusion-badge">AI</div>
                    </div>
                    @if (isDashAiLoading)
                    {
                        <div class="loading-row"><FluentProgressRing Style="width:18px;height:18px;" /> @Loc["generating"]</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(dashAiSummary))
                    {
                        <div class="ai-conclusion-text">@(showFullSummary ? dashAiSummary : FirstParagraph(dashAiSummary))</div>
                    }
                    else
                    {
                        <div class="ai-conclusion-placeholder">
                            @if (CurrentAbnormal?.Count > 0)
                            { @($"{CurrentAbnormal.Count} {Loc["ai.deviation.summary"]}") }
                            else
                            { @Loc["ai.normal.summary"] }
                        </div>
                    }
                    <div class="ai-conclusion-actions">
                        @if (!isDashAiLoading && string.IsNullOrWhiteSpace(dashAiSummary))
                        {
                            <button class="btn-primary" @onclick="GetCurrentAiSummaryAsync">@Loc["ai.btn"]</button>
                        }
                        @if (!string.IsNullOrWhiteSpace(dashAiSummary) && !isDashAiLoading)
                        {
                            <button class="btn-ghost" @onclick="() => showFullSummary = !showFullSummary">
                                @(showFullSummary ? "Згорнути" : "Читати повний висновок")
                            </button>
                        }
                    </div>
                </div>

                <!-- ── KEY DEVIATIONS ─────────────────── -->
                @if (CurrentAbnormal is { Count: > 0 })
                {
                    <section class="deviations-section">
                        <div class="section-header">
                            <div>
                                <div class="section-title">⚠ Ключові відхилення</div>
                                <div class="section-sub">@CurrentAbnormal.Count показника(ів) поза нормою</div>
                            </div>
                        </div>
                        <div class="deviation-grid">
                            @foreach (var item in CurrentAbnormal)
                            {
                                var dvClass = GetDeviationClass(item.Value, item.ReferenceRange);
                                var explainKey = item.TestName;
                                var isExpLoading = displayExplainLoading.Contains(explainKey);
                                displayExplainTexts.TryGetValue(explainKey, out var explainText);
                                <div class="deviation-card @dvClass">
                                    <div class="deviation-icon">@GetTestIcon(item.TestName)</div>
                                    <div class="deviation-name">@item.TestName</div>
                                    <div class="deviation-value">@item.Value.ToString("G6")</div>
                                    <div class="deviation-unit">@item.Unit</div>
                                    @if (!string.IsNullOrWhiteSpace(item.ReferenceRange))
                                    {
                                        <div class="deviation-range">
                                            <span class="deviation-range-label">@Loc["col.norm"]</span>
                                            <span class="deviation-range-val">@item.ReferenceRange</span>
                                        </div>
                                    }
                                    <div class="deviation-status">@GetDeviationLabel(item.Value, item.ReferenceRange)</div>
                                    <button class="btn-explain" @onclick="() => ExplainDisplayItemAsync(item)" disabled="@isExpLoading">
                                        @(isExpLoading ? Loc["ai.loading"] : (explainText != null ? "✕" : Loc["ai.short"]))
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(explainText))
                                    {
                                        <div class="explain-bubble">
                                            @explainText
                                            <button class="explain-close-btn" @onclick="() => displayExplainTexts.Remove(explainKey)">✕</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                }

                <!-- ── ALL INDICATORS ─────────────────── -->
                <section class="indicators-section">
                    <div class="section-header">
                        <div>
                            <div class="section-title">Усі показники</div>
                            <div class="section-sub">@CurrentItems?.Count показника(ів) · @(CurrentDate.HasValue ? Loc.FormatDate(CurrentDate.Value) : "")</div>
                        </div>
                        <div style="display:flex;gap:8px;align-items:center;">
                            @if (!isDemo)
                            {
                                <button class="btn-ghost" @onclick='() => OpenShare("latest")'>@Loc["share.latest"]</button>
                                <button class="btn-ghost" @onclick='() => OpenShare("all")'>@Loc["share.all"]</button>
                            }
                        </div>
                    </div>

                    @if (!isDemo && shareUrl != null)
                    {
                        <div class="share-card">
                            <span style="font-size:14px;color:#a5b4fc;">🔗</span>
                            <code class="share-url">@shareUrl</code>
                            <button class="btn-ghost" @onclick="CopyShare">@Loc["share.copy"]</button>
                            <button class="btn-ghost" @onclick="() => shareUrl = null">✕</button>
                        </div>
                    }

                    <div class="indicators-table-wrap">
                        <table class="indicators-table">
                            <thead>
                                <tr>
                                    <th>@Loc["tbl.indicator"]</th>
                                    <th class="right">@Loc["tbl.value"]</th>
                                    <th>@Loc["tbl.unit"]</th>
                                    <th>@Loc["tbl.range"]</th>
                                    <th class="center">@Loc["col.status"]</th>
                                    <th class="center">AI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in CurrentItems?.OrderBy(x => x.TestName) ?? Enumerable.Empty<DisplayItem>())
                                {
                                    var ek = item.TestName;
                                    var isEL = displayExplainLoading.Contains(ek);
                                    displayExplainTexts.TryGetValue(ek, out var et);
                                    <tr class="@(item.IsAbnormal ? "row-abn" : "")">
                                        <td class="test-name">@item.TestName</td>
                                        <td class="right @(item.IsAbnormal ? "val-warn" : "val-ok")">@item.Value.ToString("G6")</td>
                                        <td class="muted">@item.Unit</td>
                                        <td class="muted">@item.ReferenceRange</td>
                                        <td class="center">
                                            @if (item.IsAbnormal) { <span class="status-chip warn">@Loc["status.warn"]</span> }
                                            else { <span class="status-chip ok">@Loc["status.ok"]</span> }
                                        </td>
                                        <td class="center">
                                            <button class="btn-explain-sm" @onclick="() => ExplainDisplayItemAsync(item)" disabled="@isEL" title="@Loc["ai.explain"]">
                                                @(isEL ? "·" : "AI")
                                            </button>
                                        </td>
                                    </tr>
                                    @if (!string.IsNullOrWhiteSpace(et))
                                    {
                                        <tr class="tbl-explain-row">
                                            <td colspan="6">
                                                <div class="tbl-explain-cell">
                                                    <span style="flex:1;">@et</span>
                                                    <button class="explain-close-btn" @onclick="() => displayExplainTexts.Remove(ek)">✕</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- ── CATEGORY CARDS ─────────────────── -->
                @if (HasData && categoryCards is { Count: > 0 })
                {
                    <div class="section-header" style="margin-top:40px;">
                        <div class="section-title">@Loc["section.categories"]</div>
                    </div>
                    <div class="cat-grid">
                        @foreach (var cat in categoryCards)
                        {
                            var (catBg, catFg) = GetCatColors(cat.Name);
                            <div class="cat-card @(cat.HasAbnormal ? "cat-card-warn" : "")"
                                 @onclick="() => OpenCategoryHistory(cat.Name)">
                                <div class="cat-svg-icon" style="background:@catBg;color:@catFg;">
                                    @GetGroupSvg(cat.Name)
                                </div>
                                <div class="cat-name">@Loc.GetGroupName(cat.Name)</div>
                                <div class="cat-date">@Loc.FormatDate(cat.LastDate)</div>
                                <div class="cat-footer">
                                    <span style="font-size:11px;color:var(--text-muted);">@cat.Count @Loc["cat.count"]</span>
                                    @if (cat.AbnormalCount > 0) { <span class="chip chip-warn">⚠ @cat.AbnormalCount</span> }
                                    else { <span class="chip chip-ok">✓</span> }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }

        <!-- ══ HISTORY PAGE ═══════════════════════════════ -->
        @if (pageView == PageView.History)
        {
            <div class="section-header" style="padding-top:32px;">
                <div>
                    <div class="section-title">@Loc["history.title"]</div>
                    @if (filterCategory != null)
                    {
                        <div style="display:flex;align-items:center;gap:8px;margin-top:8px;">
                            <span style="font-size:13px;color:#a5b4fc;">🔍 @Loc.GetGroupName(filterCategory)</span>
                            <button @onclick="() => filterCategory = null" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:14px;">✕</button>
                        </div>
                    }
                </div>
                @if (!isDemo)
                {
                    <div style="display:flex;gap:8px;">
                        <button class="btn-ghost" @onclick='() => OpenShare("latest")'>@Loc["share.latest"]</button>
                        <button class="btn-ghost" @onclick='() => OpenShare("all")'>@Loc["share.all"]</button>
                    </div>
                }
            </div>

            @if (!isDemo && shareUrl != null)
            {
                <div class="share-card">
                    <span style="font-size:14px;color:#a5b4fc;">🔗</span>
                    <code class="share-url">@shareUrl</code>
                    <button class="btn-ghost" @onclick="CopyShare">@Loc["share.copy"]</button>
                    <button class="btn-ghost" @onclick="() => shareUrl = null">✕</button>
                </div>
            }

            @if (historyByDate is null)
            {
                <div class="loading-row"><FluentProgressRing Style="width:22px;height:22px;" /> @Loc["loading"]</div>
            }
            else if (historyByDate.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">📅</div>
                    <div class="empty-state-title">@Loc["history.empty"]</div>
                    <button class="btn-primary" @onclick="() => pageView = PageView.Main">@Loc["empty.upload"]</button>
                </div>
            }
            else
            {
                var displayHistory = filterCategory is null
                    ? historyByDate
                    : historyByDate
                        .Select(kv => new KeyValuePair<DateTime, List<LabResult>>(
                            kv.Key,
                            kv.Value.Where(r => GetLabGroup(r.TestName) == filterCategory).ToList()))
                        .Where(kv => kv.Value.Count > 0)
                        .ToDictionary(kv => kv.Key, kv => kv.Value);

                <div class="history-grid">
                    @foreach (var (date, items) in displayHistory.OrderByDescending(kv => kv.Key))
                    {
                        var isOpen     = openDates.Contains(date);
                        var abnCount   = items.Count(x => x.IsAbnormal);
                        var isLoading  = loadingAi.Contains(date);
                        var isDeleting = deletingDates.Contains(date);
                        aiSummaries.TryGetValue(date, out var dateSumm);

                        <div class="history-card @(isOpen ? "open" : "")">
                            <div class="history-card-header" @onclick="() => ToggleDate(date)">
                                <span class="history-card-chevron">▶</span>
                                <span class="history-card-date">@Loc.FormatDate(date)</span>
                                <span class="chip chip-neutral">@items.Count</span>
                                @if (abnCount > 0) { <span class="chip chip-warn">⚠ @abnCount</span> }
                                else { <span class="chip chip-ok">✓</span> }
                                <span @onclick:stopPropagation="true" style="display:flex;gap:6px;margin-left:auto;">
                                    <button class="btn-ghost" style="padding:6px 10px;font-size:12px;"
                                            @onclick="() => GetAiSummaryAsync(date, items)" disabled="@isLoading">
                                        @Loc["ai.short"]
                                    </button>
                                    @if (!isDemo)
                                    {
                                        <button class="btn-danger" style="padding:6px 10px;font-size:12px;"
                                                @onclick="() => DeleteByDateAsync(date)" disabled="@isDeleting">
                                            @(isDeleting ? "⏳" : "🗑️")
                                        </button>
                                    }
                                </span>
                            </div>

                            @if (isOpen)
                            {
                                <div class="history-card-body">
                                    @if (isLoading)
                                    {
                                        <div class="loading-row" style="padding:16px 0 8px;"><FluentProgressRing Style="width:16px;height:16px;" /> @Loc["generating"]</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(dateSumm))
                                    {
                                        <div class="ai-conclusion-card" style="margin:16px 0;">
                                            <div class="ai-conclusion-header">
                                                <div class="ai-conclusion-icon" style="width:30px;height:30px;font-size:11px;font-weight:700;">AI</div>
                                                <div class="ai-conclusion-title" style="font-size:14px;">AI висновок</div>
                                            </div>
                                            <div class="ai-conclusion-text" style="font-size:13px;">@dateSumm</div>
                                        </div>
                                    }

                                    <div style="overflow-x:auto;margin-top:12px;">
                                        <table class="indicators-table">
                                            <thead>
                                                <tr>
                                                    <th>@Loc["tbl.indicator"]</th>
                                                    <th class="right">@Loc["tbl.value"]</th>
                                                    <th>@Loc["tbl.unit"]</th>
                                                    <th>@Loc["tbl.range"]</th>
                                                    <th class="center">@Loc["col.status"]</th>
                                                    <th class="center">AI</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var r in items.OrderBy(x => x.TestName))
                                                {
                                                    var hek = r.TestName + "_" + date.Ticks;
                                                    var hel = displayExplainLoading.Contains(hek);
                                                    displayExplainTexts.TryGetValue(hek, out var het);
                                                    var hItem = new DisplayItem(hek, r.TestName, r.Value, r.Unit, r.ReferenceRange, r.IsAbnormal);
                                                    <tr class="@(r.IsAbnormal ? "row-abn" : "")">
                                                        <td class="test-name">@r.TestName</td>
                                                        <td class="right @(r.IsAbnormal ? "val-warn" : "val-ok")">@r.Value.ToString("G6")</td>
                                                        <td class="muted">@r.Unit</td>
                                                        <td class="muted">@r.ReferenceRange</td>
                                                        <td class="center">
                                                            @if (r.IsAbnormal) { <span class="status-chip warn">⚠</span> }
                                                            else { <span class="status-chip ok">✓</span> }
                                                        </td>
                                                        <td class="center">
                                                            <button class="btn-explain-sm" @onclick="() => ExplainDisplayItemAsync(hItem)" disabled="@hel">
                                                                @(hel ? "⏳" : "🤖")
                                                            </button>
                                                        </td>
                                                    </tr>
                                                    @if (!string.IsNullOrWhiteSpace(het))
                                                    {
                                                        <tr class="tbl-explain-row">
                                                            <td colspan="6">
                                                                <div class="tbl-explain-cell">
                                                                    <span>🤖</span>
                                                                    <span style="flex:1;">@het</span>
                                                                    <button class="explain-close-btn" @onclick="() => displayExplainTexts.Remove(hek)">✕</button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }

        <!-- ══ CHARTS PAGE ════════════════════════════════ -->
        @if (pageView == PageView.Charts)
        {
            <div style="padding-top:32px;">
                <div class="section-header">
                    <div class="section-title">@Loc["charts.title"]</div>
                </div>
                @if (labTypes is null)
                {
                    <div class="loading-row"><FluentProgressRing Style="width:22px;height:22px;" /> @Loc["loading"]</div>
                }
                else if (labTypes.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">📈</div>
                        <div class="empty-state-title">@Loc["charts.empty"]</div>
                    </div>
                }
                else
                {
                    <select class="chart-select" @onchange="OnTestSelected">
                        <option value="">@Loc["charts.select"]</option>
                        @if (labTypeGroups != null)
                        {
                            @foreach (var (group, names) in labTypeGroups)
                            {
                                <optgroup label="@Loc.GetGroupName(group)">
                                    @foreach (var name in names)
                                    {
                                        <option value="@name">@name</option>
                                    }
                                </optgroup>
                            }
                        }
                    </select>
                    @if (chart != null)
                    {
                        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:20px;">
                            <PlotlyChart Config="@chart.Config" Layout="@chart.Layout"
                                         Data="@chart.Data" @ref="chart" @key="chartVersion" />
                        </div>
                    }
                }
            </div>
        }

    </div><!-- /page-content -->

    <!-- ══ PARSING SPINNER (global) ══════════════════ -->
    @if (isParsing)
    {
        <div class="page-loading-overlay">
            <div style="width:56px;height:56px;border:3px solid rgba(99,102,241,.2);border-top-color:#6366f1;border-radius:50%;animation:splash-spin .8s linear infinite;"></div>
        </div>
    }

    <!-- ══ PARSED RESULTS MODAL ══════════════════════ -->
    @if (parsedResults != null && !isDemo)
    {
        var parsedAbn = parsedResults.Count(r => r.IsAbnormal);
        <div class="modal-backdrop" @onclick="DiscardParsed">
            <div class="modal-sheet" @onclick:stopPropagation>

                <!-- Modal header -->
                <div class="modal-header">
                    <div>
                        <div class="modal-title">Розпізнано @parsedResults.Count показника(ів)</div>
                        <div class="modal-sub">
                            @(selectedFile?.Name ?? "")
                            @if (parsedDate.HasValue) { <span> · @Loc.FormatDate(parsedDate.Value)</span> }
                        </div>
                    </div>
                    <button class="modal-close-btn" @onclick="DiscardParsed">✕</button>
                </div>

                <!-- Stats strip -->
                <div class="modal-stats">
                    <div class="modal-stat">
                        <span class="modal-stat-label">Дата аналізу</span>
                        <span class="modal-stat-val">@(parsedDate.HasValue ? Loc.FormatDate(parsedDate.Value) : "—")</span>
                    </div>
                    <div class="modal-stat">
                        <span class="modal-stat-label">Показників</span>
                        <span class="modal-stat-val">@parsedResults.Count</span>
                    </div>
                    <div class="modal-stat">
                        <span class="modal-stat-label">Відхилень</span>
                        <span class="modal-stat-val @(parsedAbn > 0 ? "warn" : "ok")">@(parsedAbn > 0 ? $"⚠ {parsedAbn}" : "0 ✓")</span>
                    </div>
                </div>

                <!-- AI analysis strip -->
                <div class="modal-ai-strip">
                    @if (isUploadAiLoading)
                    {
                        <div class="loading-row" style="padding:0;">
                            <FluentProgressRing Style="width:16px;height:16px;" />
                            @Loc["generating"]
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(uploadAiSummary))
                    {
                        <div class="modal-ai-text">@uploadAiSummary</div>
                    }
                    else
                    {
                        <button class="btn-primary" style="font-size:13px;padding:8px 18px;" @onclick="GetUploadAiSummaryAsync">
                            Розібрати аналіз AI
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(uploadMsg))
                {
                    <div class="modal-msg @(uploadError ? "msg-err" : "msg-ok")">@uploadMsg</div>
                }

                <!-- Scrollable table body -->
                <div class="modal-body">
                    <div class="indicators-table-wrap" style="margin:0;">
                        <table class="indicators-table">
                            <thead>
                                <tr>
                                    <th>@Loc["tbl.indicator"]</th>
                                    <th class="right">@Loc["tbl.value"]</th>
                                    <th>@Loc["tbl.unit"]</th>
                                    <th>@Loc["tbl.range"]</th>
                                    <th class="center">@Loc["col.status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in parsedResults.OrderBy(x => x.TestName))
                                {
                                    <tr class="@(m.IsAbnormal ? "row-abn" : "")">
                                        <td class="test-name">@m.TestName</td>
                                        <td class="right @(m.IsAbnormal ? "val-warn" : "val-ok")">@m.Value.ToString("G6")</td>
                                        <td class="muted">@m.Unit</td>
                                        <td class="muted">@m.ReferenceRange</td>
                                        <td class="center">
                                            @if (m.IsAbnormal) { <span class="status-chip warn">@Loc["status.warn"]</span> }
                                            else { <span class="status-chip ok">@Loc["status.ok"]</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <label class="btn-ghost" style="cursor:pointer;position:relative;overflow:hidden;">
                        Інший PDF
                        <InputFile OnChange="OnFileSelected" accept=".pdf,application/pdf"
                                   style="position:absolute;inset:0;opacity:0;cursor:pointer;" />
                    </label>
                    <button class="btn-ghost" @onclick="DiscardParsed">Скасувати</button>
                    <button class="btn-primary" @onclick="SaveAsync" disabled="@isSaving">
                        @(isSaving ? Loc["upload.saving"] : $"Додати {parsedResults.Count} показників")
                    </button>
                </div>

            </div>
        </div>
    }

    <footer class="app-footer">
        Medical AI · v0.1 · @BuildInfo.BuildAt
    </footer>
</div><!-- /page-shell -->

@code {
    private enum PageView { Main, History, Charts }
    private PageView pageView = PageView.Main;

    // ── Display Item (unified model) ──────────────────
    private record DisplayItem(string Key, string TestName, double Value, string Unit, string ReferenceRange, bool IsAbnormal);

    private IReadOnlyList<DisplayItem>? CurrentItems
    {
        get
        {
            if (parsedResults != null)
                return parsedResults.Select(m => new DisplayItem(m.TestName, m.TestName, m.Value, m.Unit, m.ReferenceRange, m.IsAbnormal)).ToList();
            var latest = historyByDate?.OrderByDescending(kv => kv.Key).FirstOrDefault();
            if (latest == null || latest.Value.Value.Count == 0) return null;
            return latest.Value.Value.Select(r => new DisplayItem(r.TestName, r.TestName, r.Value, r.Unit, r.ReferenceRange, r.IsAbnormal)).ToList();
        }
    }

    private IReadOnlyList<DisplayItem>? CurrentAbnormal => CurrentItems?.Where(i => i.IsAbnormal).ToList();

    private DateTime? CurrentDate =>
        parsedResults != null ? parsedDate :
        historyByDate?.Keys.OrderByDescending(d => d).FirstOrDefault() is DateTime d && d != default ? d : null;

    private bool HasData => historyByDate?.Count > 0;

    // ── User info ─────────────────────────────────────
    private string? userName;
    private string? userPic;

    // ── Dashboard ─────────────────────────────────────
    private List<CategoryCard>? categoryCards;
    private string? dashAiSummary;
    private bool isDashAiLoading;
    private string? lastDateStr;
    private int totalCount;
    private int abnormalCount;
    private bool showFullSummary;

    private string? CurrentSummary => parsedResults != null ? uploadAiSummary : dashAiSummary;
    private bool CurrentSummaryLoading => parsedResults != null ? isUploadAiLoading : isDashAiLoading;

    private static string FirstParagraph(string text)
    {
        var idx = text.IndexOf('\n');
        return idx > 0 ? text[..idx].Trim() : (text.Length > 300 ? text[..300].Trim() + "…" : text);
    }

    // ── Upload ────────────────────────────────────────
    private const long MaxBytes = 5 * 1024 * 1024;
    private IBrowserFile? selectedFile;
    private bool isParsing, isSaving, isUploadAiLoading;
    private string? uploadMsg;
    private bool uploadError;
    private List<ParsedLabMetric>? parsedResults;
    private DateTime? parsedDate;
    private string? uploadAiSummary;

    // ── History ───────────────────────────────────────
    private Dictionary<DateTime, List<LabResult>>? historyByDate;
    private HashSet<DateTime> openDates = new();
    private Dictionary<DateTime, string?> aiSummaries = new();
    private HashSet<DateTime> loadingAi = new();
    private HashSet<DateTime> deletingDates = new();
    private string? filterCategory;
    private string? shareUrl;
    private string? shareScope;

    // ── AI explain (unified) ──────────────────────────
    private Dictionary<string, string> displayExplainTexts = new();
    private HashSet<string> displayExplainLoading = new();

    private async Task ExplainDisplayItemAsync(DisplayItem item)
    {
        var key = item.Key;
        if (displayExplainLoading.Contains(key)) return;
        if (displayExplainTexts.ContainsKey(key)) { displayExplainTexts.Remove(key); return; }
        displayExplainLoading.Add(key);
        StateHasChanged();
        try
        {
            if (isDemo)
            {
                await Task.Delay(600);
                var demo = GetDemoExplanation(item.TestName, item.Value, item.ReferenceRange);
                displayExplainTexts[key] = demo;
            }
            else
            {
                var resp = await Http.PostAsJsonAsync("/api/LabResult/ai-explain", new
                {
                    testName = item.TestName, value = item.Value,
                    unit = item.Unit, referenceRange = item.ReferenceRange, lang = Loc.Lang,
                    sex = ProfileSvc.Current?.Sex, ageYears = ProfileSvc.Current?.AgeYears,
                    cycleDay = ProfileSvc.Current?.CycleDay
                });
                if (IsNoCredits(resp)) { showPaywall = true; return; }
                if (resp.IsSuccessStatusCode)
                {
                    var obj = await resp.Content.ReadFromJsonAsync<ExplainResponse>();
                    if (obj?.Explanation != null) displayExplainTexts[key] = obj.Explanation;
                }
            }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "AI explain failed: {Test}", item.TestName); }
        finally { displayExplainLoading.Remove(key); StateHasChanged(); }
    }

    private string GetDemoExplanation(string testName, double value, string referenceRange)
    {
        var n = testName.ToLowerInvariant();
        return Loc.Lang switch
        {
            "en" => n switch
            {
                var t when t.Contains("лейкоцит") => $"White blood cells (WBC) = {value} × 10⁹/L (ref {referenceRange}). Slightly elevated WBC may indicate a mild immune response or transient infection. In isolation this is usually not cause for concern. This is general information only and is not a substitute for professional medical advice.",
                var t when t.Contains("холестерин загальний") || t.Contains("холестерол") => $"Total cholesterol = {value} mmol/L (ref {referenceRange}). Elevated cholesterol increases cardiovascular risk over time. Diet changes and physical activity are the first-line approach. This is general information only and is not a substitute for professional medical advice.",
                var t when t.Contains("лпнщ") || t.Contains("ldl") => $"LDL cholesterol = {value} mmol/L (ref {referenceRange}). LDL ('bad' cholesterol) contributes to arterial plaque. Target levels depend on individual cardiovascular risk. This is general information only and is not a substitute for professional medical advice.",
                var t when t.Contains("тригліцерид") => $"Triglycerides = {value} mmol/L (ref {referenceRange}). Elevated triglycerides are linked to diet high in simple carbohydrates and alcohol. Reducing sugar intake typically helps normalize levels. This is general information only and is not a substitute for professional medical advice.",
                var t when t.Contains("алт") || t.Contains("alt") => $"ALT = {value} U/L (ref {referenceRange}). ALT is a liver enzyme. Mild elevation may result from physical activity, medication, or dietary factors. Persistent elevation warrants further evaluation. This is general information only and is not a substitute for professional medical advice.",
                _ => $"{testName}: value {value} (ref {referenceRange}). The result requires interpretation by your doctor in the context of your full clinical picture. This is general information only and is not a substitute for professional medical advice."
            },
            "ru" => n switch
            {
                var t when t.Contains("лейкоцит") => $"Лейкоциты = {value} × 10⁹/л (норма {referenceRange}). Незначительное повышение лейкоцитов может свидетельствовать о лёгкой иммунной реакции или временной инфекции. Изолированно это, как правило, не является серьёзным поводом для беспокойства. Ця інформація є загальноосвітньою і не замінює консультацію лікаря.",
                var t when t.Contains("холестерин загальний") || t.Contains("холестерол") => $"Загальний холестерин = {value} ммоль/л (норма {referenceRange}). Підвищений холестерин збільшує серцево-судинний ризик. Зміна харчування та фізична активність є першими кроками. Ця інформація є загальноосвітньою і не замінює консультацію лікаря.",
                var t when t.Contains("лпнщ") => $"ЛПНЩ = {value} ммоль/л (норма {referenceRange}). «Плохой» холестерин способствует образованию атеросклеротических бляшек. Целевые значения зависят от индивидуального сердечно-сосудистого риска. Ця інформація є загальноосвітньою і не замінює консультацію лікаря.",
                var t when t.Contains("тригліцерид") => $"Тригліцериди = {value} ммоль/л (норма {referenceRange}). Підвищені тригліцериди пов'язані з вживанням простих вуглеводів та алкоголю. Зниження споживання цукру зазвичай нормалізує показник. Ця інформація є загальноосвітньою і не замінює консультацію лікаря.",
                var t when t.Contains("алт") => $"АЛТ = {value} Од/л (норма {referenceRange}). АЛТ — фермент печени. Лёгкое повышение может быть связано с физической нагрузкой, приёмом лекарств или питанием. При стойком повышении рекомендуется дообследование. Ця інформація є загальноосвітньою і не замінює консультацію лікаря.",
                _ => $"{testName}: значення {value} (норма {referenceRange}). Результат потребує інтерпретації лікарем з урахуванням вашої клінічної картини. Ця інформація є загальноосвітньою і не замінює консультацію лікаря."
            },
            _ => n switch
            {
                var t when t.Contains("лейкоцит") => $"Лейкоцити = {value} × 10⁹/л (норма {referenceRange}). Незначне підвищення лейкоцитів може свідчити про легку імунну реакцію або тимчасову інфекцію. Ізольовано це, як правило, не є серйозним приводом для занепокоєння. Ця інформація є загальноосвітньою і не замінює консультацію лікаря.",
                var t when t.Contains("холестерин загальний") || t.Contains("холестерол") => $"Загальний холестерин = {value} ммоль/л (норма {referenceRange}). Підвищений холестерин збільшує серцево-судинний ризик. Зміна харчування та фізична активність є першими кроками корекції. Ця інформація є загальноосвітньою і не замінює консультацію лікаря.",
                var t when t.Contains("лпнщ") => $"Холестерин ЛПНЩ = {value} ммоль/л (норма {referenceRange}). «Поганий» холестерин сприяє утворенню атеросклеротичних бляшок. Цільові значення залежать від індивідуального серцево-судинного ризику. Ця інформація є загальноосвітньою і не замінює консультацію лікаря.",
                var t when t.Contains("тригліцерид") => $"Тригліцериди = {value} ммоль/л (норма {referenceRange}). Підвищені тригліцериди пов'язані з вживанням простих вуглеводів та алкоголю. Зниження споживання цукру зазвичай нормалізує показник. Ця інформація є загальноосвітньою і не замінює консультацію лікаря.",
                var t when t.Contains("алт") => $"АЛТ = {value} Од/л (норма {referenceRange}). АЛТ — фермент печінки. Легке підвищення може бути пов'язано з фізичним навантаженням, прийомом ліків або харчуванням. При стійкому підвищенні рекомендується додаткове обстеження. Ця інформація є загальноосвітньою і не замінює консультацію лікаря.",
                _ => $"{testName}: значення {value} (норма {referenceRange}). Результат потребує інтерпретації лікарем з урахуванням вашої клінічної картини. Ця інформація є загальноосвітньою і не замінює консультацію лікаря."
            }
        };
    }

    private record ExplainResponse(string? Explanation);

    // ── Profile modal ─────────────────────────────────
    private bool showProfileModal;
    private bool profileSaving;
    private bool profileSaved;
    private UserProfile profileEdit = new();

    private void OpenProfile()
    {
        profileEdit = ProfileSvc.Current is { } p
            ? new UserProfile { Sex = p.Sex, BirthDate = p.BirthDate, CycleDay = p.CycleDay }
            : new UserProfile();
        profileSaved = false;
        showProfileModal = true;
    }

    private void CloseProfile() => showProfileModal = false;

    private async Task SaveProfileAsync()
    {
        profileSaving = true;
        await ProfileSvc.SaveAsync(profileEdit);
        profileSaving = false;
        profileSaved = true;
        StateHasChanged();
        await Task.Delay(2000);
        profileSaved = false;
        StateHasChanged();
    }

    // ── Charts ────────────────────────────────────────
    private List<string>? labTypes;
    private Dictionary<string, List<string>>? labTypeGroups;
    private PlotlyChart? chart;
    private int chartVersion;

    // ── Error state ───────────────────────────────────
    private string? loadError;

    // ── Demo mode ─────────────────────────────────────
    private bool isDemo;

    // ── Init loading ──────────────────────────────────
    private bool isInitializing = true;

    // ── Paywall ───────────────────────────────────────
    private bool showPaywall;

    // ── Localization ──────────────────────────────────
    private Action? _locHandler;

    public void Dispose() => Loc.LanguageChanged -= _locHandler;

    private async Task SwitchLangAsync(string lang)
    {
        await Loc.SetLangAsync(lang);
        var lastDate = historyByDate?.Keys.OrderByDescending(d => d).FirstOrDefault();
        lastDateStr = lastDate.HasValue && lastDate != default ? Loc.FormatDate(lastDate.Value) : null;
    }

    // ── Init ──────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await Loc.InitAsync();
        _locHandler = () => InvokeAsync(() =>
        {
            // clear cached AI texts so next click generates in the new language
            dashAiSummary   = null;
            uploadAiSummary = null;
            aiSummaries.Clear();
            displayExplainTexts.Clear();
            showFullSummary = false;
            StateHasChanged();
        });
        Loc.LanguageChanged += _locHandler;

        isDemo = Nav.Uri.Contains("/demo", StringComparison.OrdinalIgnoreCase);

        if (!isDemo)
        {
            var user = await Auth.GetUserAsync();
            if (user.Identity?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/login");
                return;
            }
        }

        try
        {
            if (isDemo)
            {
                await LoadHistoryAsync();
                labTypes = historyByDate!.SelectMany(kv => kv.Value)
                    .Select(r => r.TestName).Distinct().OrderBy(x => x).ToList();
                labTypeGroups = labTypes
                    .GroupBy(GetLabGroup)
                    .OrderBy(g => LabGroupOrder(g.Key))
                    .ToDictionary(g => g.Key, g => g.OrderBy(x => x).ToList());
            }
            else
            {
                await Task.WhenAll(LoadHistoryAsync(), LoadLabTypesAsync());
            }
        }
        catch (Exception ex) { loadError = ex.Message; }
        finally { isInitializing = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var user = await Auth.GetUserAsync();
            if (user.Identity?.IsAuthenticated == true)
            {
                await ProfileSvc.LoadAsync();
                userName = user.FindFirst(ClaimTypes.Name)?.Value;
                userPic  = user.FindFirst("picture")?.Value;
                StateHasChanged();
            }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "OnAfterRender init failed"); }
    }

    // ── Data loading ──────────────────────────────────
    private async Task LoadHistoryAsync()
    {
        List<LabResult>? all;
        if (isDemo)
        {
            var staticUrl = Nav.BaseUri.TrimEnd('/') + "/sample-data/demo.json";
            all = await Http.GetFromJsonAsync<List<LabResult>>(staticUrl);
        }
        else
        {
            all = await Http.GetFromJsonAsync<List<LabResult>>("/api/LabResult");
        }
        historyByDate = (all ?? [])
            .GroupBy(r => r.TestDate.Date)
            .ToDictionary(g => g.Key, g => g.ToList());

        var allResults = historyByDate.SelectMany(kv => kv.Value).ToList();
        totalCount = allResults.Select(r => r.TestName).Distinct().Count();
        var lastDate = historyByDate.Keys.OrderByDescending(d => d).FirstOrDefault();
        lastDateStr = lastDate == default ? null : Loc.FormatDate(lastDate);
        abnormalCount = lastDate == default ? 0 : historyByDate[lastDate].Count(r => r.IsAbnormal);
        categoryCards = ComputeCategoryCards();
    }

    private async Task LoadLabTypesAsync()
    {
        labTypes = await Http.GetFromJsonAsync<List<string>>("/api/LabResult/labtypes");
        if (labTypes != null)
        {
            labTypeGroups = labTypes
                .GroupBy(GetLabGroup)
                .OrderBy(g => LabGroupOrder(g.Key))
                .ToDictionary(g => g.Key, g => g.OrderBy(x => x).ToList());
        }
    }

