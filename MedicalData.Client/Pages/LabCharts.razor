    private async Task GetDashAiSummaryAsync()
    {
        if (historyByDate is null or { Count: 0 }) return;
        isDashAiLoading = true; dashAiSummary = null; StateHasChanged();
        try
        {
            var latestDate = historyByDate.Keys.OrderByDescending(d => d).First();
            var items = historyByDate[latestDate];
            var body = new { date = latestDate, results = items.Select(x => new { testName = x.TestName, value = x.Value, unit = x.Unit, referenceRange = x.ReferenceRange, isAbnormal = x.IsAbnormal }) };
            var resp = await Http.PostAsJsonAsync("/api/LabResult/ai-summary", body);
            dashAiSummary = resp.IsSuccessStatusCode
                ? (await resp.Content.ReadFromJsonAsync<AiSummaryResponse>())?.Summary ?? Loc["ai.empty"]
                : Loc["ai.failed"];
        }
        catch { dashAiSummary = Loc["ai.error"]; }
        finally { isDashAiLoading = false; StateHasChanged(); }
    }

    // ── Upload logic ──────────────────────────────────
    private Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File; parsedResults = null; uploadMsg = null;
        uploadError = false; uploadAiSummary = null;
        return Task.CompletedTask;
    }

    private async Task ParsePdfAsync()
    {
        if (selectedFile is null) return;
        isParsing = true; uploadMsg = null; uploadError = false;
        parsedResults = null; parsedDate = null;
        try
        {
            using var form = new MultipartFormDataContent();
            await using var stream = selectedFile.OpenReadStream(MaxBytes);
            using var fc = new StreamContent(stream);
            fc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/pdf");
            form.Add(fc, "file", selectedFile.Name);
            form.Add(new StringContent("false"), "persist");

            var resp = await Http.PostAsync("/api/LabResult/upload-pdf", form);
            if (!resp.IsSuccessStatusCode)
            {
                uploadMsg = $"{(int)resp.StatusCode}: {await resp.Content.ReadAsStringAsync()}";
                uploadError = true; return;
            }
            var parsed    = await resp.Content.ReadFromJsonAsync<UploadPdfLabResultsResponse>();
            parsedResults = parsed?.Results ?? [];
            parsedDate    = parsed?.Date;
            uploadMsg     = parsedResults.Count == 0
                ? Loc["upload.notFound"]
                : Loc.Format("upload.found", parsedResults.Count);
            uploadError = parsedResults.Count == 0;
        }
        catch (IOException) { uploadMsg = Loc["upload.tooLarge"]; uploadError = true; }
        catch (Exception ex) { uploadMsg = Loc.Format("upload.error", ex.Message); uploadError = true; }
        finally { isParsing = false; }
    }

    private async Task SaveAsync()
    {
        if (parsedResults is null or { Count: 0 }) return;
        isSaving = true; uploadMsg = null; uploadError = false;
        try
        {
            var body = new { date = parsedDate ?? DateTime.Today, results = parsedResults.Select(x => new { testName = x.TestName, value = x.Value, unit = x.Unit, referenceRange = x.ReferenceRange, isAbnormal = x.IsAbnormal }) };
            var resp = await Http.PostAsJsonAsync("/api/LabResult/save-parsed", body);
            if (!resp.IsSuccessStatusCode)
            {
                uploadMsg = Loc.Format("upload.saveFailed", (int)resp.StatusCode);
                uploadError = true; return;
            }
            uploadMsg = Loc.Format("upload.saved", parsedResults.Count);
            parsedResults = null; tab = Tab.Dashboard;
            await Task.WhenAll(LoadHistoryAsync(), LoadLabTypesAsync());
        }
        catch (Exception ex) { uploadMsg = Loc.Format("upload.error", ex.Message); uploadError = true; }
        finally { isSaving = false; }
    }

    private async Task GetUploadAiSummaryAsync()
    {
        if (parsedResults is not { Count: > 0 }) return;
        isUploadAiLoading = true; uploadAiSummary = null; StateHasChanged();
        try
        {
