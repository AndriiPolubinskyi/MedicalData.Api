    // ── Upload logic ──────────────────────────────────
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        parsedResults = null;
        uploadMsg = null;
        uploadError = false;
        uploadAiSummary = null;
        displayExplainTexts.Clear();
        if (selectedFile != null)
        {
            Logger.LogInformation("PDF selected: {Name}, {SizeKb} KB", selectedFile.Name, selectedFile.Size / 1024);
            await ParsePdfAsync();
        }
    }

    private async Task ParsePdfAsync()
    {
        if (selectedFile is null) return;
        isParsing = true; uploadMsg = null; uploadError = false;
        parsedResults = null; parsedDate = null;
        Logger.LogInformation("Parsing PDF: {Name}", selectedFile.Name);
        try
        {
            using var form = new MultipartFormDataContent();
            await using var stream = selectedFile.OpenReadStream(MaxBytes);
            using var fc = new StreamContent(stream);
            fc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/pdf");
            form.Add(fc, "file", selectedFile.Name);
            form.Add(new StringContent("false"), "persist");

            var resp = await Http.PostAsync("/api/LabResult/upload-pdf", form);
            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                Logger.LogWarning("PDF parse failed: {Status} {Body}", (int)resp.StatusCode, body);
                uploadMsg = $"{(int)resp.StatusCode}: {body}";
                uploadError = true; return;
            }
            var parsed    = await resp.Content.ReadFromJsonAsync<UploadPdfLabResultsResponse>();
            parsedResults = parsed?.Results ?? [];
            parsedDate    = parsed?.Date;
            Logger.LogInformation("PDF parsed: {Count} results, date {Date}", parsedResults.Count, parsedDate);
            uploadMsg     = parsedResults.Count == 0
                ? Loc["upload.notFound"]
                : Loc.Format("upload.found", parsedResults.Count);
            uploadError = parsedResults.Count == 0;
            showFullSummary = false;
        }
        catch (IOException ex)
        {
            Logger.LogWarning(ex, "PDF too large: {Name}", selectedFile.Name);
            uploadMsg = Loc["upload.tooLarge"]; uploadError = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PDF parse error: {Name}", selectedFile.Name);
            uploadMsg = Loc.Format("upload.error", ex.Message); uploadError = true;
        }
        finally { isParsing = false; }
    }

    private async Task SaveAsync()
    {
        if (parsedResults is null or { Count: 0 }) return;
        isSaving = true; uploadMsg = null; uploadError = false;
        Logger.LogInformation("Saving {Count} results, date {Date}", parsedResults.Count, parsedDate);
        try
        {
            var body = new { date = parsedDate ?? DateTime.Today, results = parsedResults.Select(x => new { testName = x.TestName, value = x.Value, unit = x.Unit, referenceRange = x.ReferenceRange, isAbnormal = x.IsAbnormal }) };
            var resp = await Http.PostAsJsonAsync("/api/LabResult/save-parsed", body);
            if (!resp.IsSuccessStatusCode)
            {
                Logger.LogWarning("Save failed: {Status}", (int)resp.StatusCode);
                uploadMsg = Loc.Format("upload.saveFailed", (int)resp.StatusCode); uploadError = true; return;
            }
            Logger.LogInformation("Saved {Count} results successfully", parsedResults.Count);
            uploadMsg = Loc.Format("upload.saved", parsedResults.Count);
            parsedResults = null; selectedFile = null;
            await Task.WhenAll(LoadHistoryAsync(), LoadLabTypesAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Save error");
            uploadMsg = Loc.Format("upload.error", ex.Message); uploadError = true;
        }
        finally { isSaving = false; }
    }

