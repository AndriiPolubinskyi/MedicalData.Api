    // ── Dashboard helpers ─────────────────────────────
    private List<CategoryCard> ComputeCategoryCards()
    {
        if (historyByDate is null) return [];
        var allResults = historyByDate.SelectMany(kv => kv.Value).ToList();
        return allResults
            .GroupBy(r => GetLabGroup(r.TestName))
            .Select(g =>
            {
                var dates    = g.GroupBy(r => r.TestDate.Date).OrderBy(d => d.Key).ToList();
                var lastDate = dates.Last().Key;
                var lastItems = dates.Last().ToList();
                var abnCount = lastItems.Count(r => r.IsAbnormal);
                var count    = g.Select(r => r.TestName).Distinct().Count();
                var sparkVals = dates.Select(d => (double)d.Count(r => r.IsAbnormal) / d.Count() * 100).ToList();
                return new CategoryCard(g.Key, lastDate, count, abnCount, abnCount > 0);
            })
            .OrderBy(c => LabGroupOrder(c.Name))
            .ToList();
    }

    private static string GenerateSparklinePoints(List<double> values)
    {
        if (values.Count < 2) return "0,28 100,28";
        var min = values.Min(); var max = values.Max(); var range = max - min;
        return string.Join(" ", values.Select((v, i) =>
        {
            var x = (double)i / (values.Count - 1) * 100;
            var y = range == 0 ? 15.0 : 28.0 - (v - min) / range * 24.0;
            return $"{x:F1},{y:F1}";
        }));
    }

