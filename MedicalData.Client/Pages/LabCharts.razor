    // ── Delete by date ────────────────────────────────
    private async Task DeleteByDateAsync(DateTime date)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            Loc.Format("delete.confirm", Loc.ShortDate(date), date.Year));
        if (!confirmed) return;
        deletingDates.Add(date); StateHasChanged();
        try
        {
            var resp = await Http.DeleteAsync($"/api/LabResult/by-date?date={date:yyyy-MM-dd}");
            if (resp.IsSuccessStatusCode)
            {
                openDates.Remove(date); aiSummaries.Remove(date);
                await Task.WhenAll(LoadHistoryAsync(), LoadLabTypesAsync());
            }
        }
        finally { deletingDates.Remove(date); StateHasChanged(); }
    }

    // ── History logic ─────────────────────────────────
    private void ToggleDate(DateTime d)
    {
        if (!openDates.Add(d)) openDates.Remove(d);
    }

    private async Task GetAiSummaryAsync(DateTime date, List<LabResult> items)
    {
        loadingAi.Add(date); StateHasChanged();
        try
        {
            var body = new { date, results = items.Select(x => new { testName = x.TestName, value = x.Value, unit = x.Unit, referenceRange = x.ReferenceRange, isAbnormal = x.IsAbnormal }) };
            var resp = await Http.PostAsJsonAsync("/api/LabResult/ai-summary", body);
            aiSummaries[date] = resp.IsSuccessStatusCode
                ? (await resp.Content.ReadFromJsonAsync<AiSummaryResponse>())?.Summary ?? Loc["ai.empty"]
                : Loc["ai.failed"];
            if (!openDates.Contains(date)) openDates.Add(date);
        }
        catch { aiSummaries[date] = Loc["ai.error"]; }
        finally { loadingAi.Remove(date); StateHasChanged(); }
    }

    // ── Chart logic ───────────────────────────────────
    private async Task OnTestSelected(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (string.IsNullOrEmpty(name)) { chart = null; return; }

        var results = await Http.GetFromJsonAsync<List<LabResult>>(
            $"/api/LabResult/labresults?testName={Uri.EscapeDataString(name)}");
        if (results is not { Count: > 0 }) { chart = null; return; }

        var ordered  = results.OrderBy(r => r.TestDate).ToList();
        var refRange = ordered.FirstOrDefault(x => !string.IsNullOrEmpty(x.ReferenceRange))?.ReferenceRange ?? "";

        chart = new PlotlyChart
        {
            Data = [new Scatter
            {
                Name = refRange,
                Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines | Plotly.Blazor.Traces.ScatterLib.ModeFlag.Markers,
                X    = ordered.Select(r => (object)r.TestDate.ToString("dd.MM.yy")).ToList(),
                Y    = ordered.Select(r => (object)r.Value).ToList(),
                Line = new Plotly.Blazor.Traces.ScatterLib.Line { Color = "#6366f1" },
                Marker = new Plotly.Blazor.Traces.ScatterLib.Marker { Size = 8 },
            }],
            Layout = new Layout
            {
                Title = new Title { Text = name },
                XAxis = [new() { Title = new Plotly.Blazor.LayoutLib.XAxisLib.Title { Text = Loc["charts.xLabel"] } }],
                YAxis = [new() { Title = new Plotly.Blazor.LayoutLib.YAxisLib.Title { Text = refRange } }],
                Margin = new Margin { L = 60, R = 20, T = 50, B = 60 },
            },
            Config = new Plotly.Blazor.Config { Responsive = true }
        };
        chartVersion++;
        StateHasChanged();
    }

    // ── Grouping helpers ──────────────────────────────
    private static string GetLabGroup(string name)
    {
        var n = name.ToLowerInvariant();
        if (n.Contains("холестерин") || n.Contains("тригліцерид") || n.Contains("ліпо") ||
            n.Contains("лпвщ") || n.Contains("лпнщ") || n.Contains("лпднщ") ||
            n.Contains("hdl") || n.Contains("ldl") || n.Contains("vldl") ||
            n.Contains("chol") || n.Contains("атероген") || n.Contains("non-hdl") ||
            n.Contains("не-лпвщ") || n.Contains("non–hdl"))
            return "Ліпідограма";

        if (n.Contains("гемоглобін") || n.Contains("еритроцит") || n.Contains("лейкоцит") ||
            n.Contains("тромбоцит") || n.Contains("гематокрит") || n.Contains("шое") ||
            n.Contains("лімфоцит") || n.Contains("моноцит") || n.Contains("базофіл") ||
            n.Contains("еозинофіл") || n.Contains("сегментоядерн") || n.Contains("паличкоядерн") ||
            n.Contains("метамієлоцит") || n.Contains("мієлоцит") || n.Contains("тромбокрит") ||
            n.Contains("плазматичн") || n.Contains("вірoцит") ||
            n.Contains("hgb") || n.Contains("rbc") || n.Contains("wbc") || n.Contains("plt") ||
            n.Contains("hct") || n.Contains("esr") || n.Contains("mcv") || n.Contains("mch") ||
            n.Contains("rdw") || n.Contains("mpv") || n.Contains("pct") || n.Contains("pdw") ||
            n.Contains("ly%") || n.Contains("mo%") || n.Contains("ba%") || n.Contains("eo%") ||
            n.Contains("ne%"))
            return "Загальний аналіз крові";

        if (n.Contains("глюкоза") || n.Contains("білок") || n.Contains("білірубін") ||
            n.Contains("алт") || n.Contains("аст") || n.Contains("лужна фосфатаза") ||
            n.Contains("ггт") || n.Contains("лактатдегідрогеназа") ||
            n.Contains("alt") || n.Contains("ast") || n.Contains("alp") || n.Contains("ggt") ||
            n.Contains("ldh") || n.Contains("glu") || n.Contains("glucose") ||
            n.Contains("tbil") || n.Contains("dbil") || n.Contains("ibil"))
            return "Біохімія";

        if (n.Contains("інсулін") || n.Contains("глікозильован") || n.Contains("hba1c") ||
            n.Contains("нома") || n.Contains("пептид") || n.Contains("тестостерон") ||
            n.Contains("лютеїнізуючий") || n.Contains("глобулін") || n.Contains("fai") ||
            n.Contains("testosterone") || n.Contains("insulin"))
            return "Гормони та ендокринологія";

        if (n.Contains("пса") || n.Contains("psa") || n.Contains("простат"))
            return "Онкомаркери";

        if (n.Contains("хелікобактер") || n.Contains("helicobacter") ||
            n.Contains("антитіл") || n.Contains("вірус") || n.Contains("інфекц"))
            return "Інфекційна серологія";

        return "Інше";
    }

