    // ── Deviation helpers ─────────────────────────────
    private static string GetDeviationClass(double value, string? referenceRange)
    {
        if (string.IsNullOrWhiteSpace(referenceRange)) return "dv-other";
        if (referenceRange.StartsWith('<') || referenceRange.StartsWith("до "))
            return value > 0 ? "dv-high" : "dv-other";
        var dash = referenceRange.IndexOfAny(['-', '–']);
        if (dash > 0)
        {
            if (double.TryParse(referenceRange[..dash].Replace(',', '.').Trim(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var lo))
                return value < lo ? "dv-low" : "dv-high";
        }
        return "dv-other";
    }

    private string GetDeviationLabel(double value, string? referenceRange)
    {
        var cls = GetDeviationClass(value, referenceRange);
        return cls switch { "dv-high" => Loc["dv.high"], "dv-low" => Loc["dv.low"], _ => Loc["dv.other"] };
    }

    private static string GetTestIcon(string name)
    {
        var n = name.ToLowerInvariant();
        if (n.Contains("гемоглобін") || n.Contains("еритро") || n.Contains("hgb")) return "🩸";
        if (n.Contains("холестерин") || n.Contains("ліпо") || n.Contains("тригліцер")) return "💧";
        if (n.Contains("глюкоза") || n.Contains("інсулін")) return "🍬";
        if (n.Contains("алт") || n.Contains("аст") || n.Contains("білірубін")) return "🧪";
        if (n.Contains("феритин") || n.Contains("залізо")) return "🔴";
        if (n.Contains("вітамін") || n.Contains("vitamin")) return "☀️";
        if (n.Contains("лейкоцит") || n.Contains("wbc")) return "🛡️";
        return "📊";
    }

